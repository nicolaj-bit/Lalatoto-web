{% doc %}
  @prompt
    Vil du lave vores flipbook grid, så den virker og sørge for at den passer til vores design
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-flipbook-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-flipbook-grid__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-flipbook-grid__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-flipbook-grid__title-{{ ai_gen_id }} {
    font-family: var(--heading-font-family);
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }

  .ai-flipbook-grid__subtitle-{{ ai_gen_id }} {
    font-family: var(--text-font-family);
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-flipbook-grid__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.grid_top_spacing }}px;
  }

  @media screen and (max-width: 999px) {
    .ai-flipbook-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-flipbook-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap_mobile }}px;
    }

    .ai-flipbook-grid__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }

    .ai-flipbook-grid__subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.9);
    }
  }

  .ai-flipbook-card-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
  }

  .ai-flipbook-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .ai-flipbook-card__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-flipbook-card__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .ai-flipbook-card-{{ ai_gen_id }}:hover .ai-flipbook-card__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-flipbook-card__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-flipbook-card__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-flipbook-card__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-flipbook-card__title-{{ ai_gen_id }} {
    font-family: var(--heading-font-family);
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 8px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    line-height: 1.3;
  }

  .ai-flipbook-card__description-{{ ai_gen_id }} {
    font-family: var(--text-font-family);
    font-size: {{ block.settings.card_description_size }}px;
    color: {{ block.settings.card_description_color }};
    margin: 0 0 16px;
    line-height: 1.6;
  }

  .ai-flipbook-card__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-family: var(--text-font-family);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .ai-flipbook-card__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    transform: translateY(-2px);
  }

  .ai-flipbook-card__badge-{{ ai_gen_id }} {
    position: absolute;
    top: 16px;
    right: 16px;
    padding: 6px 12px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: 4px;
    z-index: 2;
  }

  .ai-flipbook-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-flipbook-empty-state__icon-{{ ai_gen_id }} {
    width: 80px;
    height: 80px;
    margin: 0 auto 20px;
    opacity: 0.3;
  }

  .ai-flipbook-empty-state__text-{{ ai_gen_id }} {
    font-size: 16px;
    color: #999;
  }
{% endstyle %}

<flipbook-grid-{{ ai_gen_id }}
  class="ai-flipbook-grid-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-flipbook-grid__container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-flipbook-grid__header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-flipbook-grid__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <div class="ai-flipbook-grid__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% liquid
      assign has_content = false
      for i in (1..6)
        assign image_key = 'flipbook_' | append: i | append: '_image'
        assign title_key = 'flipbook_' | append: i | append: '_title'
        assign enabled_key = 'flipbook_' | append: i | append: '_enabled'
        
        if block.settings[enabled_key] and block.settings[image_key] != blank
          assign has_content = true
          break
        endif
      endfor
    %}

    {% if has_content %}
      <div class="ai-flipbook-grid__grid-{{ ai_gen_id }}">
        {% for i in (1..6) %}
          {% liquid
            assign enabled_key = 'flipbook_' | append: i | append: '_enabled'
            assign image_key = 'flipbook_' | append: i | append: '_image'
            assign title_key = 'flipbook_' | append: i | append: '_title'
            assign description_key = 'flipbook_' | append: i | append: '_description'
            assign link_key = 'flipbook_' | append: i | append: '_link'
            assign button_text_key = 'flipbook_' | append: i | append: '_button_text'
            assign badge_key = 'flipbook_' | append: i | append: '_badge'

            assign is_enabled = block.settings[enabled_key]
            assign flipbook_image = block.settings[image_key]
            assign flipbook_title = block.settings[title_key]
            assign flipbook_description = block.settings[description_key]
            assign flipbook_link = block.settings[link_key]
            assign flipbook_button_text = block.settings[button_text_key]
            assign flipbook_badge = block.settings[badge_key]
          %}

          {% if is_enabled %}
            <div class="ai-flipbook-card-{{ ai_gen_id }}" data-flipbook-id="{{ i }}">
              <div class="ai-flipbook-card__image-wrapper-{{ ai_gen_id }}">
                {% if flipbook_image != blank %}
                  <img
                    src="{{ flipbook_image | image_url: width: 800 }}"
                    alt="{{ flipbook_image.alt | escape }}"
                    loading="lazy"
                    width="{{ flipbook_image.width }}"
                    height="{{ flipbook_image.height }}"
                    class="ai-flipbook-card__image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-flipbook-card__placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}

                {% if flipbook_badge != blank %}
                  <div class="ai-flipbook-card__badge-{{ ai_gen_id }}">{{ flipbook_badge }}</div>
                {% endif %}
              </div>

              <div class="ai-flipbook-card__content-{{ ai_gen_id }}">
                {% if flipbook_title != blank %}
                  <h3 class="ai-flipbook-card__title-{{ ai_gen_id }}">{{ flipbook_title }}</h3>
                {% endif %}

                {% if flipbook_description != blank %}
                  <div class="ai-flipbook-card__description-{{ ai_gen_id }}">{{ flipbook_description }}</div>
                {% endif %}

                {% if flipbook_link != blank and flipbook_button_text != blank %}
                  <a
                    href="{{ flipbook_link }}"
                    class="ai-flipbook-card__button-{{ ai_gen_id }}"
                  >
                    {{ flipbook_button_text }}
                  </a>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-flipbook-empty-state-{{ ai_gen_id }}">
        <div class="ai-flipbook-empty-state__icon-{{ ai_gen_id }}">
          {{ 'collection-1' | placeholder_svg_tag }}
        </div>
        <p class="ai-flipbook-empty-state__text-{{ ai_gen_id }}">
          Tilføj billeder og indhold til dine flipbooks for at komme i gang
        </p>
      </div>
    {% endif %}
  </div>
</flipbook-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class FlipbookGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-flipbook-card-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.cards.forEach((card) => {
          const link = card.querySelector('.ai-flipbook-card__button-{{ ai_gen_id }}');
          
          if (link) {
            card.addEventListener('click', (e) => {
              if (e.target.tagName !== 'A') {
                link.click();
              }
            });
          }
        });
      }
    }

    customElements.define('flipbook-grid-{{ ai_gen_id }}', FlipbookGrid{{ ai_gen_id }});
  })();
</script>

