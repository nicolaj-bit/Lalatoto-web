{%- doc -%}
  Lalatoto: kort til én artikel i journalen. Billede i 3:2, en lille linje
  med dato og læsetid, titel i Playfair og en kort tekst. Bruges på
  journalens forside, under artikler («Læs også») og på forsiden.

  Den korte tekst er artiklens uddrag; mangler det, bruges starten af
  artiklen. Formatering fra Word (skrifttyper, størrelser) fjernes.

  @param {object} article - artiklen
  @param {string} [size] - 'large' giver det store kort øverst på journalen
  @param {boolean} [eager] - true indlæser billedet med det samme
  @param {boolean} [show_excerpt] - false skjuler den korte tekst
{%- enddoc -%}

{%- liquid
  assign words = article.content | strip_html | split: ' ' | size
  assign minutes = words | divided_by: 200 | at_least: 1
  assign excerpt = article.excerpt | strip_html | strip
  if excerpt == blank
    assign excerpt = article.content | strip_html | strip
  endif
  if size == 'large'
    assign excerpt = excerpt | truncatewords: 42
    assign sizes = '(max-width: 999px) 100vw, 58vw'
  else
    assign excerpt = excerpt | truncatewords: 22
    assign sizes = '(max-width: 699px) 100vw, (max-width: 999px) 50vw, 420px'
  endif
  assign loading = 'lazy'
  if eager
    assign loading = 'eager'
  endif
-%}

<article class="lalatoto-journal-card{% if size == 'large' %} lalatoto-journal-card--large{% endif %}">
  <a href="{{ article.url }}" class="lalatoto-journal-card__media" tabindex="-1" aria-hidden="true">
    {%- if article.image -%}
      {{-
        article.image
        | image_url: width: 1600
        | image_tag: loading: loading, sizes: sizes, widths: '400,600,800,1000,1200,1600', alt: article.image.alt
      -}}
    {%- else -%}
      {{- 'lifestyle-1' | placeholder_svg_tag -}}
    {%- endif -%}
  </a>

  <div class="lalatoto-journal-card__body">
    <p class="lalatoto-journal-card__meta">
      {{- article.published_at | time_tag: format: 'date' -}}
      <span aria-hidden="true">·</span>
      {{- 'lalatoto.journal.reading_time' | t: minutes: minutes -}}
    </p>

    <h3 class="lalatoto-journal-card__title">
      <a href="{{ article.url }}">{{ article.title | escape }}</a>
    </h3>

    {%- unless show_excerpt == false -%}
      {%- if excerpt != blank -%}
        <p class="lalatoto-journal-card__excerpt">{{ excerpt }}</p>
      {%- endif -%}
    {%- endunless -%}

    {%- if size == 'large' -%}
      <a href="{{ article.url }}" class="lalatoto-journal-card__more">
        {{- 'lalatoto.journal.read_more' | t -}}
        <span aria-hidden="true">→</span>
      </a>
    {%- endif -%}
  </div>
</article>
