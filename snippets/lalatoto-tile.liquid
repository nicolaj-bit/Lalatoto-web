{%- doc -%}
  Lalatoto: ét kort i kollektionen. Viser billede og produktets navn, intet
  andet. Linket åbner produktsiden med netop denne variant valgt.

  @param {object} product - produktet
  @param {object} variant - varianten, kortet står for (farven i første tilgængelige størrelse)
  @param {object} [media] - billedet; tomt: variantens billede og ellers produktets
  @param {boolean} [sold_out] - true dæmper kortet
  @param {boolean} [eager] - true indlæser billedet med det samme (de første kort)
  @param {boolean} [priority] - true beder browseren hente billedet først (første kort)
  @param {object} [hover_media] - billede, der toner frem, når musen holdes over kortet
  @param {boolean} [show_price] - true viser prisen under navnet
  @param {string} [variant_label] - farven, kortet står for; vises under navnet
{%- enddoc -%}

{%- liquid
  assign image = media | default: variant.featured_media | default: product.featured_media
  assign url = variant.url | default: product.url
  assign loading = 'lazy'
  if eager
    assign loading = 'eager'
  endif
  assign image_alt = product.title
  if variant_label != blank
    assign image_alt = product.title | append: ', ' | append: variant_label
  endif
  assign fetchpriority = 'auto'
  if priority
    assign fetchpriority = 'high'
  endif
-%}

{%- liquid
  comment
    Udsolgt eller kommer snart: står «Venteliste» slået til på produktet
    (metafeltet lalatoto.waitlist under Metafelter), skrives «Kommer snart».
  endcomment
  if product.metafields.lalatoto.waitlist.value == true
    assign sold_out_label = 'lalatoto.collection.coming_soon' | t
  else
    assign sold_out_label = 'lalatoto.collection.sold_out' | t
  endif
-%}

<li class="lalatoto-tile{% if sold_out %} is-sold-out{% endif %}">
  <a href="{{ url }}" class="lalatoto-tile__link">
    <div class="lalatoto-tile__media">
      {%- if image != blank -%}
        {{-
          image
          | image_url: width: 1200
          | image_tag:
            loading: loading,
            fetchpriority: fetchpriority,
            sizes: '(max-width: 999px) 50vw, (max-width: 1400px) 25vw, 350px',
            widths: '300,400,500,600,800,1000,1200',
            alt: image_alt
        -}}
        {%- if hover_media != blank and hover_media.id != image.id -%}
          {{-
            hover_media
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              sizes: '(max-width: 999px) 50vw, (max-width: 1400px) 25vw, 350px',
              widths: '300,400,500,600,800,1000,1200',
              alt: '',
              class: 'lalatoto-tile__hover'
          -}}
        {%- endif -%}
      {%- else -%}
        {{- 'product-1' | placeholder_svg_tag -}}
      {%- endif -%}
    </div>
    <span class="lalatoto-tile__info">
      <span class="lalatoto-tile__name">{{ product.title }}</span>
      {%- if variant_label != blank -%}
        <span class="lalatoto-tile__variant">{{ variant_label }}</span>
      {%- endif -%}
      {%- if show_price -%}
        {%- liquid
          comment
            Et farvekort viser farvens pris. Et samlet kort for et produkt med
            forskellige priser (størrelser, beløb) viser «Fra» og laveste pris.
          endcomment
          assign card_variant = variant | default: product.selected_or_first_available_variant
          assign show_from = false

          comment
            «Tilbud i procent» (lalatoto.tilbud, 1–90): prisen vises med
            tilbuddet trukket fra og den almindelige pris overstreget.
          endcomment
          assign tilbud = product.metafields.lalatoto.tilbud.value | default: 0 | plus: 0
          if tilbud < 1 or tilbud > 90
            assign tilbud = 0
          endif
          assign tilbud_factor = 100 | minus: tilbud
          if tilbud > 0
            assign card_price = card_variant.price | times: tilbud_factor | divided_by: 100.0 | round
            assign card_compare = card_variant.price
            assign card_price_min = product.price_min | times: tilbud_factor | divided_by: 100.0 | round
          else
            assign card_price = card_variant.price
            assign card_compare = card_variant.compare_at_price
            assign card_price_min = product.price_min
          endif
          if variant_label == blank and product.price_varies
            assign show_from = true
          endif
        -%}
        <span class="lalatoto-tile__price">
          {%- if sold_out -%}
            {{- sold_out_label -}}
          {%- elsif show_from -%}
            {%- assign price_min = card_price_min | money -%}
            {{- 'product.price.from_price_html' | t: price_min: price_min -}}
          {%- else -%}
            {%- if card_compare > card_price -%}
              <s class="lalatoto-tile__compare">{{ card_compare | money }}</s>
              <span class="lalatoto-tile__sale">{{ card_price | money }}</span>
            {%- else -%}
              {{ card_price | money }}
            {%- endif -%}
          {%- endif -%}
        </span>
      {%- endif -%}
    </span>
    {%- if sold_out and show_price != true -%}
      <span class="sr-only">{{ sold_out_label }}</span>
    {%- endif -%}
  </a>
</li>
