{%- doc -%}
  Lalatoto: «Fortæl mere» på produktsiden. Linket står under Læg i kurv, og
  modalen samler al produktinformation med en indholdsfortegnelse øverst.

  Afsnittenes indhold hentes fra produktets metafelter i navnerummet «lalatoto».
  «Levering og retur» falder tilbage på en fælles side, hvis produktet ikke har
  sin egen tekst. Afsnit uden indhold vises ikke.

  @param {object} product - produktet
  @param {object} block - blokken «lalatoto_more_info»
  @param {string} mode - 'button' for linket eller 'modal' for selve modalen
  @param {string} modal_id - id på modalen
{%- enddoc -%}

{%- liquid
  assign keys = 'materialer,maal,vask_og_pleje,sikkerhed,levering_og_retur' | split: ','
  assign has_content = false

  for key in keys
    assign value = product.metafields.lalatoto[key]
    if value != blank
      assign has_content = true
    elsif key == 'levering_og_retur' and block.settings.shipping_returns_page.content != blank
      assign has_content = true
    endif
  endfor
-%}

{%- if has_content -%}
  {%- if mode == 'button' -%}
    <button type="button" class="lalatoto-more-info-link" aria-controls="{{ modal_id }}" aria-haspopup="dialog">
      <span>{{- 'lalatoto.product.tell_more' | t -}}</span>
      <span class="lalatoto-more-info-link__arrow" aria-hidden="true">→</span>
    </button>
  {%- else -%}
    <lalatoto-info-modal>
      <dialog id="{{ modal_id }}" class="lalatoto-info-modal color-scheme color-scheme--scheme-1" aria-labelledby="{{ modal_id }}-title">
        <div class="lalatoto-info-modal__panel">
          <div class="lalatoto-info-modal__header">
            <p id="{{ modal_id }}-title" class="lalatoto-info-modal__title h4">{{ product.title }}</p>

            <button type="button" class="lalatoto-info-modal__close" data-lalatoto-close>
              <span class="sr-only">{{ 'general.accessibility.close' | t }}</span>
              {%- render 'icon' with 'close', width: 16 -%}
            </button>
          </div>

          <div class="lalatoto-info-modal__scroll" data-lalatoto-scroll>
            <nav class="lalatoto-info-modal__toc" aria-label="{{ 'lalatoto.product.contents' | t | escape }}">
              <p class="lalatoto-info-modal__toc-title smallcaps">{{ 'lalatoto.product.contents' | t }}</p>

              <ol data-lalatoto-toc>
                {%- for key in keys -%}
                  {%- liquid
                    assign value = product.metafields.lalatoto[key]
                    if value == blank and key == 'levering_og_retur'
                      assign value = block.settings.shipping_returns_page.content
                    endif
                  -%}
                  {%- if value != blank -%}
                    {%- assign title_key = 'lalatoto.product.sections.' | append: key -%}
                    <li><a href="#{{ modal_id }}-{{ key }}">{{ title_key | t }}</a></li>
                  {%- endif -%}
                {%- endfor -%}
              </ol>
            </nav>

            <div class="lalatoto-info-modal__body">
              {%- for key in keys -%}
                {%- liquid
                  assign metafield = product.metafields.lalatoto[key]
                  assign content = ''
                  if metafield != blank
                    assign content = metafield | metafield_tag
                  elsif key == 'levering_og_retur'
                    assign content = block.settings.shipping_returns_page.content
                  endif
                -%}
                {%- if content != blank -%}
                  {%- assign title_key = 'lalatoto.product.sections.' | append: key -%}
                  <section id="{{ modal_id }}-{{ key }}" class="lalatoto-info-modal__section" data-lalatoto-section>
                    <h2 class="h4">{{ title_key | t }}</h2>
                    <div class="prose">{{ content }}</div>
                  </section>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      </dialog>
    </lalatoto-info-modal>
  {%- endif -%}
{%- endif -%}
