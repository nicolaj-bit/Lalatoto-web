{%- doc -%}
  This component renders a selector for a localization component (either country or locale).

  @param {string} type - can be either "country" or "locale"
  @param {boolean} [show_country_name] - for type "country", if set to true the country name is shown
  @param {boolean} [show_country_flag] - for type "country", if set to true the country flag is shown
  @param {string} [id_prefix] - an optional prefix to help dissociate the ID in case this is included several times in the same section
  @param {string} [placement] - the placement of the popover, default is "bottom-start". It can be set to any of the popover placements available in the theme (top, top-start, top-end, bottom, bottom-start, bottom-end, left, left-start, left-end, right, right-start, right-end)
  @param {object} [section]
  @param {boolean} [long] - Lalatoto: viser «Dansk» i stedet for sprogkoden og «Valuta · DKK» i stedet for valutakoden (bruges i mobilmenuen)
{%- enddoc -%}

{%- capture localization_form_id -%}localization-form-{{ id_prefix }}-{{ section.id }}-{{ type }}{%- endcapture -%}
{%- capture localization_popover_id -%}popover-localization-{{ id_prefix }}-{{ section.id }}-{{ type }}{%- endcapture -%}

{%- case type -%}
  {%- when 'country' -%}
    {%- comment -%}
      ----------------------------------------------------------------------------------------------
      COUNTRY SELECTOR
      ----------------------------------------------------------------------------------------------
    {%- endcomment -%}

    <div class="relative">
      <button
        type="button"
        class="localization-toggle heading text-xxs link-faded"
        aria-controls="{{ localization_popover_id }}"
        aria-label="{{ 'general.localization.change_country_accessibility_text' | t | escape }}"
        aria-expanded="false"
      >
        {%- if show_country_flag -%}
          {{- localization.country | image_url: width: 60, format: 'jpg' | image_tag: class: 'country-flag' -}}
        {%- endif -%}

        {%- comment -%}
          Lalatoto: kun valutakoden (DKK, EUR, NOK, SEK) i samme skrift som
          sprogkoden. I mobilmenuen (long) står «Valuta · DKK».
        {%- endcomment -%}
        {%- if long -%}
          <span class="lalatoto-locale-code">{{ 'lalatoto.localization.currency' | t }} · {{ localization.country.currency.iso_code }}</span>
        {%- elsif show_country_name -%}
          <span>
            {{- localization.country.name }} ({{ localization.country.currency.iso_code }}
            {% if localization.country.currency.symbol %}{{ localization.country.currency.symbol }}){%- endif -%}
          </span>
        {%- else -%}
          <span class="lalatoto-locale-code">{{- localization.country.currency.iso_code -}}</span>
        {%- endif -%}

        {%- render 'icon' with 'chevron-down' -%}
      </button>

      <x-popover
        id="{{ localization_popover_id }}"
        initial-focus="[aria-selected='true']"
        class="popover popover--{{ placement | default: 'bottom-start' }} color-scheme color-scheme--dialog"
      >
        <p class="h4" slot="header">{{ 'lalatoto.localization.currency' | t }}</p>

        {%- comment -%}
          Lalatoto: kun én linje pr. valuta (DKK, EUR, NOK, SEK) i stedet for
          alle lande. Shopify skal have et land, så hver valuta sender et land
          med den valuta: det, kunden allerede er i, hvis det passer, ellers
          det foretrukne (DK, NL, NO, SE) og til sidst det første med valutaen.
          DKK giver dansk, de øvrige valutaer giver engelsk.

          Hver valuta har sin egen lille formular med land og sprog som faste
          felter, så valget virker uden JavaScript og ens i alle browsere
          (også Safari på iPhone).
        {%- endcomment -%}
        {%- liquid
          assign lalatoto_currencies = 'DKK,EUR,NOK,SEK' | split: ','
          assign lalatoto_preferred = 'DK,NL,NO,SE' | split: ','
        -%}
        <x-listbox class="popover__value-list">
          {%- for currency_code in lalatoto_currencies -%}
            {%- liquid
              assign currency_country = nil
              assign preferred_code = lalatoto_preferred[forloop.index0]
              if localization.country.currency.iso_code == currency_code
                assign currency_country = localization.country
              endif
              if currency_country == nil
                for country in localization.available_countries
                  if country.iso_code == preferred_code and country.currency.iso_code == currency_code
                    assign currency_country = country
                    break
                  endif
                endfor
              endif
              if currency_country == nil
                for country in localization.available_countries
                  if country.currency.iso_code == currency_code
                    assign currency_country = country
                    break
                  endif
                endfor
              endif
            -%}
            {%- if currency_country == nil -%}{%- continue -%}{%- endif -%}

            {%- liquid
              assign is_selected = false
              if localization.country.currency.iso_code == currency_code
                assign is_selected = true
              endif
              assign lalatoto_target_language = 'en'
              if currency_code == 'DKK'
                assign lalatoto_target_language = 'da'
              endif
              assign currency_form_id = localization_form_id | append: '-' | append: currency_code
            -%}

            {%- form 'localization', id: currency_form_id, class: 'contents' -%}
              <input type="hidden" name="country_code" value="{{ currency_country.iso_code }}">
              <input type="hidden" name="language_code" value="{{ lalatoto_target_language }}">
              <button
                type="submit"
                class="popover__value-option h-stack gap-2.5"
                role="option"
                value="{{ currency_code }}"
                aria-selected="{% if is_selected %}true{% else %}false{% endif %}"
              >
                <span>
                  {{- currency_code -}}
                  {%- if currency_country.currency.symbol %} {{ currency_country.currency.symbol }}{%- endif -%}
                </span>
              </button>
            {%- endform -%}
          {%- endfor -%}
        </x-listbox>
      </x-popover>
    </div>

  {%- when 'locale' -%}
    {%- comment -%}
      ----------------------------------------------------------------------------------------------
      LOCALE SELECTOR
      ----------------------------------------------------------------------------------------------
    {%- endcomment -%}

    <div class="relative">
      <button
        type="button"
        class="localization-toggle heading text-xxs link-faded"
        aria-controls="{{ localization_popover_id }}"
        aria-label="{{ 'general.localization.change_language_accessibility_text' | t | escape }}"
        aria-expanded="false"
      >
        {%- comment -%}Lalatoto: kun en kort kode (DK, EN, DE) i menuens skrift. Dansk står som DK.{%- endcomment -%}
        {%- assign locale_code = localization.language.iso_code | split: '-' | first | upcase -%}
        {%- if locale_code == 'DA' -%}{%- assign locale_code = 'DK' -%}{%- endif -%}
        {%- if long -%}
          <span class="lalatoto-locale-code">{{ localization.language.endonym_name | capitalize }}</span>
        {%- else -%}
          <span class="lalatoto-locale-code">{{- locale_code -}}</span>
        {%- endif -%}
        {%- render 'icon' with 'chevron-down' -%}
      </button>

      <x-popover
        id="{{ localization_popover_id }}"
        initial-focus="[aria-selected='true']"
        class="popover popover--{{ placement | default: 'bottom-start' }} color-scheme color-scheme--dialog"
      >
        <p class="h4" slot="header">{{ 'general.localization.language' | t }}</p>

        {%- form 'localization', id: localization_form_id -%}
          {%- liquid
            comment
              Lalatoto: tysk er kun slået til i EU-markedet. Står kunden i et
              marked uden tysk (fx Danmark), vises «Deutsch» alligevel. Et klik
              skifter både sprog og land til Tyskland, så priserne følger med i euro.
            endcomment
            assign lalatoto_has_german = false
            for language in localization.available_languages
              if language.iso_code == 'de'
                assign lalatoto_has_german = true
              endif
            endfor
            assign lalatoto_germany_available = false
            for country in localization.available_countries
              if country.iso_code == 'DE'
                assign lalatoto_germany_available = true
              endif
            endfor
          -%}
          {%- if lalatoto_has_german == false and lalatoto_germany_available -%}
            <input type="hidden" name="country_code" value="DE" disabled data-lalatoto-country>
          {%- endif -%}
          <x-listbox class="popover__value-list">
            {%- for language in localization.available_languages -%}
              {%- assign is_selected = false -%}

              {%- if language.iso_code == localization.language.iso_code -%}
                {%- assign is_selected = true -%}
              {%- endif -%}

              <button
                type="submit"
                name="locale_code"
                class="popover__value-option"
                role="option"
                value="{{ language.iso_code }}"
                aria-selected="{% if is_selected %}true{% else %}false{% endif %}"
              >
                {{- language.endonym_name | capitalize -}}
              </button>
            {%- endfor -%}

            {%- if lalatoto_has_german == false and lalatoto_germany_available -%}
              <button
                type="submit"
                name="locale_code"
                class="popover__value-option"
                role="option"
                value="de"
                aria-selected="false"
                onclick="var c = this.form.querySelector('[data-lalatoto-country]'); if (c) { c.disabled = false; }"
              >
                Deutsch
              </button>
            {%- endif -%}
          </x-listbox>
        {%- endform -%}
      </x-popover>
    </div>
{%- endcase -%}
