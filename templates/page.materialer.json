        "princip_2": {
          "type": "principle",
          "settings": {
            "title": "Ingen salgsgas",
            "text": "<p>Vi skjuler ikke dårlig kvalitet bag smarte formuleringer eller markedsføring.<br/>Vi romantiserer ikke polyester ved at sætte ’recycled’ foran eller kalder noget naturligt når fibersammensætningen er 80/20.<br/>Vi fortæller dig præcis hvad du får. Også dét som du ikke kan se.</p>"
          }
        },
        "princip_3": {
          "type": "principle",
          "settings": {
            "title": "<em>Billigt</em> er ikke et godt nok argument",
            "text": "<p>Vi tror på færre, bedre ting.<br/>Vi går ikke på kompromis med materialer, håndværk eller ordentlige arbejdsforhold for at ramme en bestemt pris.<br/>God kvalitet koster dét den gør.<br/>Hverken mere eller mindre.<br/>For alle involverede.</p>"
          }
