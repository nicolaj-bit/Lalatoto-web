          }
        },
        "custom_QzLgyD": {
          "type": "custom",
          "settings": {
            "name": "Dani",
            "date": "4. nov. 2024",
            "des": "<p><strong>Vi fik ENDELIG sammenhængende søvn igen.</strong><br/>Vi fik ENDELIG sammenhængende søvn igen, efter vi fik <a href=\"/collections/tyngdedyner\" title=\"Tyngdedyner\">tyngdedynen</a> og mulitinesten fra Lalatoto. Jeg kan ikke anbefale deres produkter nok! 🙌🏼❤️</p>",
