          "type": "testimonial",
          "settings": {
            "content": "<p><em>\"Nogle børn har brug for det sansemæssige input for at kunne finde ro, og til det vil vi til en hver tid anbefale LALATOTOs søvnprodukter. De skaber tryg søvn i kemifrie tekstiler - og den bevidsthed og ærekærhed omkring produkterne ser vi som en kæmpe kvalitet og den opbygger en stor troværdighed.\"</em></p>",
            "logo_max_width": 140,
            "logo_mobile_max_width": 100,
            "author": "<strong>Mie Lindholm - Easeyourbaby</strong>"
          }
        },
        "testimonial_xAFyFV": {
          "type": "testimonial",
          "settings": {
            "content": "<p><em>\"LALATOTO er på listen over anbefalede webshops i mit onlineunivers Grøn Stue fordi de arbejder med rene naturmaterialer og trygge rammer for børns søvn\".</em></p>",
            "logo_max_width": 140,
            "logo_mobile_max_width": 100,
            "author": "<strong>Rose Maimonide - Grøndstue</strong>"
          }
        },
        "testimonial_LXVGrX": {
          "type": "testimonial",
          "settings": {
            "content": "<p><em>\"Efter at have testet tyngdedynen, kan jeg med sikkerhed sige, at LALATOTO er min favorit. Deres produkter er gennemført i kvalitet og design, og det er tydeligt, at der er stor omtanke bag hver eneste detalje\".</em></p>",
            "logo_max_width": 140,
            "logo_mobile_max_width": 100,
            "author": "<strong>Malene Dafne - Balancebørn</strong>"
          }
        }
      },
