          "settings": {
            "name": "Christine T",
            "date": "4. nov. 2024",
            "des": "<p><strong>Fntastisk produkt til babys søvn<br/></strong>Vores søn på 4 måneder har indtil nu kun ville falde i søvn<br/>i bevægelse i enten slyngvugge eller barnevogn. Vi har prøvet alt, men valgte<br/>at give jeres tyngdedyne et forsøg og han er nu for første gang faldet nemt og<br/>hurtigt i søvn i sin SENG. Tusind tak for et godt produkt 🧡</p>",
            "product": ""
          }
        },
        "custom_PeXfhf": {
