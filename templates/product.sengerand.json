        "richtext_XMzipM": {
          "type": "richtext",
          "settings": {
            "content": "<p><em>..vores </em><a href=\"/collections/sengerand\" title=\"Sengerand\"><em>sengerand</em></a><em> udsprang af et ønske om at tilbyde<br/>forældre et alternativ til alle de polyesterfyldte sengerande, som dominerer markedet. Vi er efterhånden mange, som foretrækker naturens materialer, hvilket giver fantastisk mening i et produkt som en sengerand, hvor barnet opholder sig en stor del af sit liv i de første spæde år. <br/><br/>Jeg er hamrende stolt, af dét produkt, og jeg synes, at vi har formået at gøre sengeranden både praktisk, sund og smuk”.</em></p>"
          }
        },
