    "storyline_mkP6ze": {
      "type": "Storyline",
      "blocks": {
        "image_yeGtkC": {
          "type": "Image",
          "settings": {
            "date": "November 2021",
            "image": "shopify://shop_images/Billede_11.jpg",
            "heading": "Nu gør vi det sgu!",
            "para": "Nu gør vi det sgu! Vi satser hele butikken og går begge fuldtid i virksomheden. Det er med lige dele nervøsitet og begejstring, at vi dropper funktionærvejen for at følge vores drøm.",
            "side": "Left"
          }
        },
        "image_wHNNVL": {
          "type": "Image",
          "settings": {
            "date": "December 2021",
            "heading": "Vi skifter navn",
            "para": "Vores tyngdedyne begynder så småt at vinde indpas i de danske hjem og vores ambitioner bliver større. Babydynen kan efterhånden ikke følge med vores drømme længere, og vi skifter navn til Hush Little One – et navn vi KNUS ELSKER og stadig niver os i armen over dén dag i dag.",
            "side": "Left"
          }
        },
        "image_xMPbeA": {
          "type": "Image",
          "settings": {
            "date": "Januar 2022",
            "image": "shopify://shop_images/Billede_13.jpg",
            "heading": "Vi kan også andet end tyngdedyner",
            "para": "Vi lancerer vores dynebetræk og Mulitnest, og ønsket om at skabe et univers af produkter til den trygge søvn brænder mere end nogensinde!",
            "side": "Left"
          }
        },
        "image_HrMNrw": {
          "type": "Image",
          "settings": {
            "date": "Juni 2022",
            "heading": "”Hvad gør vi?”",
            "para": "Første halvår i 2022 går ikke som forventet. Krigen i Ukraine og inflation gør at e-handelsbutikker lider - og det gør vi også. Voldsomt. Det er med nød og næppe, at vi kan betale vores regninger, og takket være verdens bedste leverandører, kommer vi igennem.",
            "side": "Left"
          }
        },
        "image_BRyyMF": {
          "type": "Image",
          "settings": {
            "date": "August 2022",
            "image": "shopify://shop_images/Billede_15.jpg",
            "heading": "”Er vi købt eller solgt”?",
            "para": "I august pitcher vi i Løvens Hule og får et ”ja” fra Anne Stampe. De efterfølgende fire måneder går med en lang due diligence proces, hvor vi ikke aner, om vi er købt eller solgt. Det er nogle virkelig svære måneder med uvished og hemmelighedskræmmeri.",
            "side": "Left"
          }
        },
        "image_X4qmMy": {
          "type": "Image",
          "settings": {
            "date": "November 2022",
            "image": "shopify://shop_images/Billede_16.jpg",
            "heading": "”Det er bare ikke os”.",
            "para": "Virksomheden har så meget vokseværk, at det er tid til at flytte lageret ud af kælderen og lade andre om at afsende pakker. Nicolaj er ikke helt tryg ved at afgive dét ansvar, og det er da heller ikke uden udfordringer. Efter et par måneder beslutter vi at opgive logistikcentret. Det bliver for upersonligt for os. Nu får systuen lov at varetage opgaven.",
            "side": "Left"
          }
        },
        "image_y3xqeh": {
          "type": "Image",
          "settings": {
            "date": "December 2022",
            "image": "shopify://shop_images/2_1.png",
            "heading": "YEEEEESS!!!",
            "para": "Det lykkedes! I december kan vi ENDELIG fejre at Anne Stampe har investeret i Hush Little One og vi har endda fået endnu en kompetent investor med på holdet, nemlig Louise Skarby. Vi er ikke til at skyde igennem! Nu får vi travlt!",
            "side": "Left"
          }
        },
        "image_M39yJB": {
          "type": "Image",
          "settings": {
            "date": "Januar 2023",
            "image": "shopify://shop_images/Billede_18.jpg",
            "heading": "”Tænk at vi er arbejdsgivere”",
            "para": "Vi starter året med at byde Natalija velkommen til Hush Familien. Natalija skal supportere på kundeservicedelen så Sara kan få frigivet noget tid til blandt andet produktudvikling.",
            "side": "Left"
          }
        },
        "image_Ap3Fna": {
          "type": "Image",
          "settings": {
            "date": "Marts 2023",
            "image": "shopify://shop_images/Billede_19.jpg",
            "heading": "LØVENS HULE BABY!",
            "para": "Ventetiden har været ubærlig og det er en kæmpe forløsning,da vi endelig ruller over skærmen som sæsonens sidste deltagere i Løvens Hule. Den opbakning vi modtager fra danskerne efter programmet, er fuldstændig overvældende, og den efterfølgende måned har vi SÅ travlt, at det hele stadig står lidt tåget.",
            "side": "Left"
          }
        },
        "image_JmNmwa": {
          "type": "Image",
          "settings": {
            "date": "Juni 2023",
            "image": "shopify://shop_images/HushLittleOne_Maj23_0570.jpg",
            "heading": "Krammegåsen Gertrud",
            "para": "Efter 10 måneders produktudvikling kan vi endelig lancere Krammegåsen Gertrud, som hurtigt vinder vores kunders hjerter.",
            "side": "Left"
          }
        },
        "image_diYGdC": {
          "type": "Image",
          "settings": {
            "date": "Augst 2023",
            "image": "shopify://shop_images/Design_uden_navn_13.png",
            "heading": "SVAMPELAMPEN",
            "para": "Vi har længe haft en vision om en ammevenlig natlampe og i løbet af sommeren dykker Sara ned i alt, hvad der er at vide om lys, lamper og plaststøbning i samarbejde med en lokal virksomhed. Ud af dette vokser idéen om Svampelampen; en lampe, som ved et enkelt puf lyser rødt, og dermed forstyrrer søvnhormonerne mindst muligt, når der er behov for lys om natten. Svampelampen får enorm interesse fra kunderne.",
            "side": "Left"
          }
        },
        "image_9h9R4W": {
          "type": "Image",
          "settings": {
            "date": "August 2023",
            "image": "shopify://shop_images/svampelampe_a01.jpg",
            "heading": "KICKSTARTER",
            "para": "At producere en lampe fra bunden er en omkostelig affære, og derfor bliver vi præsenteret for ideen om at lave en Crowdfundingskampagne, altså en kampagne hvor kunderne køber lampen på forhånd, så vi kan få dækket opstartsudgifterne til produktionen.\n Det synes vi er ret så genialt og i August går vores kampagne live på Kickstarter.",
            "side": "Left"
          }
        },
        "image_KpAKcR": {
          "type": "Image",
          "settings": {
            "date": "September 2023",
            "image": "shopify://shop_images/IMG_5417_95d69629-2248-492f-b063-0105bdec2f89.jpg",
            "heading": "FARVEL TIL SVAMPELAMPEN",
            "para": "Vi funder 160.000 kr. på den måned vi har, til at hive pengene i land, men det er desværre ikke nok. Det er naturligvis en meget stor skuffelse at begrave Svampelampen, men allersværest er det, at afsluttet samarbejdet med de mennesker som skulle have produceret lampen, og som har hjulpet os så ufattelig meget igennem processen.",
            "side": "Left"
          }
        }
      },
