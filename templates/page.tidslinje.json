    "storyline_FJgzYk": {
      "type": "Storyline",
      "blocks": {
        "image_E7dGQb": {
          "type": "Image",
          "settings": {
            "date": "April 2024",
            "heading": "NUL OMSÆTNING",
            "para": "Det nye år starter med en konflikt med systuen i Polen, vores eneste producent. Dette resulterer i, at de nægter os vores varer, medmindre vi går med på nogle urimelige betalingsbetingelser. Vi går derfor i tre måneder uden omsætning.",
            "side": "Left"
          }
        },
        "image_63qrMF": {
          "type": "Image",
          "settings": {
            "date": "Oktober 2024",
            "image": "shopify://shop_images/1_1_c1de9f3d-eb22-4ebc-9cd9-b5911e5ebb98.png",
            "heading": "HUSH LITTLE ONE GÅR KONKURS",
            "para": "Ud af desperation ser vi os nødsaget til at gå med på deres betingelser og ikke overraskende bliver virksomheden kort tid efter erklæret inhabil.\n Det er med blødende hjerte, at vi må sige farvel til vores hjertebarn efter 7 års arbejde.",
            "side": "Left"
          }
        },
        "image_8KDPMb": {
          "type": "Image",
          "settings": {
            "date": "Oktober 2024",
            "heading": "VI ER IKKE FÆRDIGE",
            "para": "Da det værste chok har lagt sig, og hovedet begynder at tænke klart igen, mærker vi noget nyt spire i kroppen; vi er nemlig slet ikke færdige! Om det er stædighed, passion eller dét dér iværksætter-DNA som ikke helt kan forklares, ved jeg ikke, men vi nægter at lægge os ned, og efter mange lange nætter, tårer, grin og begejstring ser LALATOTO of Denmark dagens lys.",
            "side": "Left"
          }
        },
        "image_KG3FKn": {
          "type": "Image",
          "settings": {
            "date": "Oktober 2024",
            "image": "shopify://shop_images/LALATOTO_LOGOFILER_2.png",
            "heading": "LALATOTO",
            "para": "LALATOTO betyder ’sov mit barn’ og bliver navnet på vores nye søvnunivers til de mindste.\nVores passion for at skabe smukke, ærlige og tryghedsskabende soveprodukter i den bedste kvalitet brænder mere end nogensinde før, men det skal heller ikke være nogen hemmelighed, at dét at starte totalt forfra bestemt ikke er nemt.",
            "side": "Left"
          }
        },
        "image_GTfXx9": {
          "type": "Image",
          "settings": {
            "date": "Januar 2025",
            "image": "shopify://shop_images/1_5.png",
            "heading": "NEJ TAK TIL POLYESTER",
            "para": "Nye samarbejdspartnere og ny systue betyder også nye muligheder. Vi mærker en stor personlig passion for ærlige og naturlige materialer, og det afføder en klar mission, nemlig at få polyester ud af børneværelset.\n Vi bruger nu udelukkende naturens materialer, og selvom det gør processen både dyrere og mere kompliceret, så føles det bare helt rigtigt.",
            "side": "Left"
          }
        }
      },
