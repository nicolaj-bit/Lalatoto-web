{%- comment -%}
  Lalatoto: kollektionsside. Centreret overskrift med en kort linje under og
  derefter produkterne med kun billede og navn. Ingen priser, filtre eller
  sortering. Fire kolonner på computer og to på telefon.

  Overskriften hentes fra kollektionens metafelt lalatoto.heading og ellers fra
  kollektionens navn. Teksten under hentes fra lalatoto.intro og ellers fra
  hele kollektionens beskrivelse. Beskrivelsen ryddes for formatering fra Word
  og andre programmer, så kun afsnittene står tilbage.
{%- endcomment -%}

{%- liquid
  assign heading = collection.metafields.lalatoto.heading.value | default: collection.title
  assign intro = collection.metafields.lalatoto.intro.value
  if intro == blank and collection.description != blank
    comment
      Afsnit og linjeskift bliver til et skilletegn, alt andet HTML fjernes,
      og hvert stykke tekst bliver sit eget afsnit.
    endcomment
    assign marker = '¶'
    assign cleaned = collection.description
      | replace: '</p>', marker
      | replace: '</div>', marker
      | replace: '<br>', marker
      | replace: '<br/>', marker
      | replace: '<br />', marker
      | replace: '<br aria-hidden="true">', marker
      | strip_html
      | replace: '&nbsp;', ' '
    assign intro_parts = cleaned | split: marker
  endif
-%}

{%- paginate collection.products by section.settings.products_per_page -%}
  <div class="lalatoto-collection color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
    <header class="lalatoto-collection__head">
      {%- liquid
        assign kicker = section.settings.kicker
        if kicker == blank
          assign kicker = 'lalatoto.collection.kicker' | t
        endif
      -%}
      <p class="lalatoto-kicker">{{ kicker | escape }}</p>
      <h1 class="lalatoto-collection__title">{{ heading | escape }}</h1>

      {%- if intro != blank -%}
        <div class="lalatoto-lead"><p>{{ intro | escape }}</p></div>
      {%- elsif intro_parts.size > 0 -%}
        <div class="lalatoto-lead">
          {%- for part in intro_parts -%}
            {%- assign part = part | strip -%}
            {%- if part != blank -%}
              <p>{{ part }}</p>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </header>

    {%- if collection.products.size > 0 -%}
      {%- comment -%}
        Ét kort per farve. Farven er den valgmulighed, der hedder Farve, Color,
        Colour eller Farbe. Rækkefølgen følger produkterne i kollektionen og
        derefter varianterne. Hvert kort bruger den første tilgængelige
        variant i farven; er hele farven udsolgt, dæmpes kortet og bruger den
        første variant. Produkter uden farve får ét kort.
      {%- endcomment -%}
      {%- assign color_names = 'farve,color,colour,farbe' | split: ',' -%}
      {%- assign card_index = 0 -%}

      <ul class="lalatoto-tiles unstyled-list" role="list">
        {%- for product in collection.products -%}
          {%- liquid
            assign color_index = -1
            for option in product.options_with_values
              assign option_name = option.name | downcase | strip
              if color_names contains option_name
                assign color_index = option.position | minus: 1
                assign color_option_name = option.name
                break
              endif
            endfor
          -%}

          {%- if color_index < 0 or product.has_only_default_variant -%}
            {%- liquid
              assign card_index = card_index | plus: 1
              assign eager = false
              if card_index <= 4
                assign eager = true
              endif
              assign priority = false
              if card_index == 1
                assign priority = true
              endif
              assign sold_out = true
              if product.available
                assign sold_out = false
              endif
            -%}
            {%- render 'lalatoto-tile', product: product, variant: product.selected_or_first_available_variant, sold_out: sold_out, eager: eager, priority: priority -%}
          {%- else -%}
            {%- assign seen = '|' -%}
            {%- for variant in product.variants -%}
              {%- assign color = variant.options[color_index] -%}
              {%- assign color_key = '|' | append: color | append: '|' -%}

              {%- unless seen contains color_key -%}
                {%- liquid
                  assign seen = seen | append: color | append: '|'

                  assign chosen = variant
                  assign sold_out = true
                  for candidate in product.variants
                    if candidate.options[color_index] == color and candidate.available
                      assign chosen = candidate
                      assign sold_out = false
                      break
                    endif
                  endfor

                  comment
                    Billede: variantens eget billede. Har varianten intet, bruges det
                    første billede, hvis alt-tekst indeholder «#Farve_<farve>», som er
                    Prestiges måde at knytte billeder til en farve på.
                  endcomment
                  assign media = chosen.featured_media
                  if media == blank
                    assign alt_key = '#' | append: color_option_name | append: '_' | append: color | downcase
                    for m in product.media
                      assign alt = m.alt | downcase
                      if alt contains alt_key
                        assign media = m
                        break
                      endif
                    endfor
                  endif

                  assign card_index = card_index | plus: 1
                  assign eager = false
                  if card_index <= 4
                    assign eager = true
                  endif
                  assign priority = false
                  if card_index == 1
                    assign priority = true
                  endif
                -%}
                {%- render 'lalatoto-tile', product: product, variant: chosen, media: media, sold_out: sold_out, eager: eager, priority: priority -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- render 'pagination', paginate: paginate -%}
    {%- else -%}
      <p class="lalatoto-collection__empty">{{ 'lalatoto.collection.empty' | t }}</p>
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Lalatoto kollektion",
  "class": "shopify-section--lalatoto-collection",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farveskema",
      "default": "scheme-1"
    },
    {
      "type": "paragraph",
      "content": "Produktbilleder lægges ind på selve produktet (Produkter → produkt → Medier), ikke her. Anbefalet: 1600 × 2000 px (4:5, stående), JPG med baggrund i stedet for fritlagt PNG, sRGB, under ca. 300 KB pr. billede. Kollektionssiden viser billederne i 4:5, så andre forhold beskæres dér."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Lille etiket over overskriften"
    },
    {
      "type": "paragraph",
      "content": "Overskriften og linjen under den rettes på selve kollektionen under Produkter → Kollektioner (metafelterne Overskrift og Indledning, ellers kollektionens navn og beskrivelse)."
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Produkter pr. side",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    }
  ]
}
{% endschema %}
