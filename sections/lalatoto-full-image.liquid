{%- comment -%}
  Lalatoto: et billede i fuld bredde uden tekst.
{%- endcomment -%}

{%- liquid
  comment
    Alt-tekst til Google og skærmlæsere: feltet i sektionen, ellers billedets egen.
  endcomment
  assign image_alt = section.settings.image_alt | default: section.settings.image.alt
-%}

<div class="lalatoto-full-image color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  {%- if section.settings.image != blank -%}
    <picture>
      {%- if section.settings.mobile_image != blank -%}
        <source
          media="(max-width: 699px)"
          srcset="{{ section.settings.mobile_image | image_url: width: 600 }} 600w, {{ section.settings.mobile_image | image_url: width: 900 }} 900w, {{ section.settings.mobile_image | image_url: width: 1200 }} 1200w"
          width="{{ section.settings.mobile_image.width }}"
          height="{{ section.settings.mobile_image.height }}"
        >
      {%- endif -%}

      {{-
        section.settings.image
        | image_url: width: section.settings.image.width
        | image_tag:
          loading: 'lazy',
          sizes: '100vw',
          widths: '600,800,1000,1200,1400,1600,1800,2000,2400,2800,3200',
          class: 'lalatoto-full-image__image',
          alt: image_alt
      -}}
    </picture>
  {%- else -%}
    {{- 'lifestyle-1' | placeholder_svg_tag: 'lalatoto-full-image__image placeholder' -}}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Lalatoto billede",
  "class": "shopify-section--lalatoto-full-image",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farveskema",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Billede",
      "info": "Anbefalet: 2400 × 1050 px (16:7, liggende). Vises i fuld skærmbredde og med billedets egne proportioner. Brug JPG (ikke PNG), sRGB, under ca. 500 KB. Shopify laver selv mindre udgaver og WebP; større end anbefalet gør kun siden langsommere."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Billedtekst til Google (alt-tekst)",
      "info": "Beskriv kort, hvad billedet viser, fx «Baby sover under uld dyne i tremmeseng». Hjælper Google Billeder og skærmlæsere."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Billede på telefon",
      "info": "Valgfrit. Bruges i stedet for billedet ovenfor på telefon. Anbefalet: 1200 × 1500 px (4:5). Brug JPG (ikke PNG), sRGB, under ca. 250 KB. Shopify laver selv mindre udgaver og WebP; større end anbefalet gør kun siden langsommere."
    }
  ],
  "presets": [
    {
      "name": "Lalatoto billede"
    }
  ]
}
{% endschema %}
