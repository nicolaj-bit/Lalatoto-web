{%- comment -%}
  Lalatoto: kontaktsiden.

  Overskriften og en kort undertekst står centreret øverst. Under dem tre
  nummererede punkter side om side (chat, e-mail og kontaktformular), og
  nederst Shopifys kontaktformular. På telefon står punkterne under
  hinanden.

  Teksterne kommer fra sprogfilerne (lalatoto.contact.*), så de findes på
  dansk, engelsk og tysk. Overskrift og undertekst kan overskrives i
  temaeditoren.

  Formularen er Shopifys kontaktformular, så beskederne lander i den
  indbakke, der er sat op under Indstillinger → Butiksoplysninger.
{%- endcomment -%}

{%- liquid
  assign form_id = 'lalatoto-contact-' | append: section.id

  assign title = section.settings.title
  if title == blank
    assign title = 'lalatoto.contact.page_title' | t
  endif

  assign subtitle = section.settings.subtitle
  if subtitle == blank
    assign subtitle = 'lalatoto.contact.page_subtitle' | t
  endif

  assign email = section.settings.email | default: 'kundeservice@lalatoto.dk'
  capture email_link
    echo '<a href="mailto:' | append: email | append: '">' | append: email | append: '</a>'
  endcapture
-%}

<div class="lalatoto-contact color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <header class="lalatoto-contact__intro">
    <h1 class="lalatoto-contact__title">{{ title | escape }}</h1>
    <p class="lalatoto-contact__subtitle">{{ subtitle | escape }}</p>
  </header>

  <ol class="lalatoto-contact__ways unstyled-list" role="list">
    <li class="lalatoto-contact__way">
      <span class="lalatoto-contact__num" aria-hidden="true">01</span>
      <h2 class="lalatoto-contact__way-title">{{ 'lalatoto.contact.chat_title' | t }}</h2>
      <p>{{ 'lalatoto.contact.chat_text' | t }}</p>
    </li>
    <li class="lalatoto-contact__way">
      <span class="lalatoto-contact__num" aria-hidden="true">02</span>
      <h2 class="lalatoto-contact__way-title">{{ 'lalatoto.contact.mail_title' | t }}</h2>
      <p>{{ 'lalatoto.contact.mail_text_html' | t: email: email_link }}</p>
    </li>
    <li class="lalatoto-contact__way">
      <span class="lalatoto-contact__num" aria-hidden="true">03</span>
      <h2 class="lalatoto-contact__way-title">{{ 'lalatoto.contact.form_title' | t }}</h2>
      <p>{{ 'lalatoto.contact.form_text' | t }}</p>
    </li>
  </ol>

  <div class="lalatoto-contact__card" id="kontaktformular">
    {%- form 'contact', id: form_id, class: 'lalatoto-contact__form' -%}
      {%- if form.posted_successfully? -%}
        <div class="lalatoto-contact__done" role="status">
          <svg class="lalatoto-waitlist__check" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
            <circle cx="24" cy="24" r="23" />
            <path d="M15 24.5l6 6 12-13" />
          </svg>
          <p class="lalatoto-contact__done-title">{{ 'lalatoto.contact.done_title' | t }}</p>
          <p class="lalatoto-contact__muted">{{ 'lalatoto.contact.done_text' | t }}</p>
        </div>
      {%- else -%}
        {%- if form.errors -%}
          <p class="lalatoto-waitlist__error lalatoto-contact__error" role="alert">{{ 'lalatoto.contact.error' | t }}</p>
        {%- endif -%}

        <div class="lalatoto-contact__fields">
          <div class="lalatoto-contact__row">
            <div class="lalatoto-contact__line">
              <label for="{{ form_id }}-name">{{ 'lalatoto.contact.name' | t }}</label>
              <input type="text" id="{{ form_id }}-name" name="contact[{{ 'lalatoto.contact.name' | t }}]" autocomplete="name" required value="{{ form.name }}">
            </div>

            <div class="lalatoto-contact__line">
              <label for="{{ form_id }}-email">{{ 'lalatoto.contact.email' | t }}</label>
              <input type="email" id="{{ form_id }}-email" name="contact[email]" autocomplete="email" inputmode="email" spellcheck="false" required value="{{ form.email }}">
            </div>
          </div>

          <div class="lalatoto-contact__row">
            <div class="lalatoto-contact__line">
              <label for="{{ form_id }}-phone">{{ 'lalatoto.contact.phone' | t }} <span>({{ 'lalatoto.contact.optional' | t }})</span></label>
              <input type="tel" id="{{ form_id }}-phone" name="contact[{{ 'lalatoto.contact.phone' | t }}]" autocomplete="tel" inputmode="tel">
            </div>

            <div class="lalatoto-contact__line">
              <label for="{{ form_id }}-order">{{ 'lalatoto.contact.order' | t }} <span>({{ 'lalatoto.contact.optional' | t }})</span></label>
              <input type="text" id="{{ form_id }}-order" name="contact[{{ 'lalatoto.contact.order' | t }}]">
            </div>
          </div>

          <div class="lalatoto-contact__line lalatoto-contact__line--area">
            <label for="{{ form_id }}-body">{{ 'lalatoto.contact.message' | t }}</label>
            <textarea id="{{ form_id }}-body" name="contact[body]" rows="4" required>{{ form.body }}</textarea>
          </div>
        </div>

        <button type="submit" class="lalatoto-contact__submit">{{ 'lalatoto.contact.submit' | t }}</button>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Lalatoto kontakt",
  "class": "shopify-section--lalatoto-contact",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farveskema",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Overskrift",
      "info": "Tom: «Kontakt os» på det valgte sprog."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Undertekst",
      "info": "Tom: «Du vælger, hvordan.» på det valgte sprog."
    },
    {
      "type": "text",
      "id": "email",
      "label": "E-mail",
      "default": "kundeservice@lalatoto.dk"
    }
  ],
  "presets": [
    {
      "name": "Lalatoto kontakt"
    }
  ]
}
{% endschema %}
