{%- comment -%}
  Lalatoto: udvalgte spørgsmål og svar (fx på forsiden).

  Hver blok peger på et spørgsmål fra metaobjektet «FAQ (produkter)», så
  teksten og oversættelserne kun skal rettes ét sted. Udseendet er det
  samme som FAQ'en under produkterne. Nederst et link til hele FAQ-siden.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'lalatoto.faq.heading' | t
  endif
-%}

<div class="lalatoto-faq color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <header class="lalatoto-faq__head">
    <p class="lalatoto-kicker">{{ 'lalatoto.faq.kicker' | t }}</p>
    <h2 class="lalatoto-faq__title">{{ heading | escape }}</h2>
  </header>

  <div class="lalatoto-wash__list" data-lalatoto-accordion>
    {%- for block in section.blocks -%}
      {%- assign entry = block.settings.question -%}
      {%- if entry == blank or entry.sporgsmal.value == blank -%}{%- continue -%}{%- endif -%}
      <details class="lalatoto-wash__item" name="lalatoto-faq-{{ section.id }}" {{ block.shopify_attributes }}>
        <summary class="lalatoto-wash__summary">
          <span class="lalatoto-wash__name">{{ entry.sporgsmal.value | escape }}</span>
          <span class="lalatoto-wash__sign" aria-hidden="true"></span>
        </summary>
        <div class="lalatoto-wash__body">
          <div class="lalatoto-wash__text">{{ entry.svar | metafield_tag }}</div>
        </div>
      </details>
    {%- endfor -%}
  </div>

  {%- if section.settings.link_text != blank and section.settings.link_url != blank -%}
    <a href="{{ section.settings.link_url }}" class="lalatoto-image-text__link">{{ section.settings.link_text | escape }}</a>
  {%- endif -%}
</div>

<script src="{{ 'lalatoto-accordion.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Lalatoto udvalgt FAQ",
  "class": "shopify-section--lalatoto-faq",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farveskema",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "info": "Tom: «Spørgsmål og svar»."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Linktekst",
      "default": "Se alle spørgsmål"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Spørgsmål",
      "settings": [
        {
          "type": "metaobject",
          "id": "question",
          "label": "Spørgsmål",
          "metaobject_type": "lalatoto_faq",
          "info": "Spørgsmål og svar rettes under Indhold → Metaobjekter → FAQ (produkter)."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lalatoto udvalgt FAQ"
    }
  ]
}
{% endschema %}
