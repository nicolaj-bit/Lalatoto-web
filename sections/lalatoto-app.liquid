{%- comment -%}
  Lalatoto: Club No Sleep-appen. Dæmpet baggrund i fuld bredde med tekst til
  venstre og to telefoner til højre. På telefon står teksten øverst og
  billederne under.

  Alle tekster kan rettes i temaeditoren. Står et felt tomt, bruges temaets
  oversatte standardtekst fra sprogfilerne (lalatoto.app).

  Knapperne: på iPhone og iPad vises kun App Store, på Android kun Google Play,
  og på computer begge. Det afgøres af et lille script, der sætter
  data-platform på sektionen. Uden JavaScript vises begge.
{%- endcomment -%}

{%- liquid
  assign kicker = section.settings.kicker
  if kicker == blank
    assign kicker = 'lalatoto.app.kicker' | t
  endif

  assign heading_line_1 = section.settings.heading_line_1
  assign heading_line_2 = section.settings.heading_line_2
  if heading_line_1 == blank and heading_line_2 == blank
    assign heading_line_1 = 'lalatoto.app.heading_line_1' | t
    assign heading_line_2 = 'lalatoto.app.heading_line_2' | t
  endif

  assign text = section.settings.text
  if text == blank
    assign text = 'lalatoto.app.text' | t
  endif

  assign app_store_url = section.settings.app_store_url | default: 'https://apps.apple.com/dk/app/id6764388095'
  assign google_play_url = section.settings.google_play_url | default: 'https://play.google.com/store/apps/details?id=com.base699f47a86e7e0a874d1159ed.app'
-%}

<div
  id="lalatoto-app-{{ section.id }}"
  class="lalatoto-app color-scheme color-scheme--{{ section.settings.color_scheme.id }}"
>
  <div class="lalatoto-app__inner">
    <div class="lalatoto-app__copy">
      <p class="lalatoto-kicker">{{ kicker | escape }}</p>

      <h2 class="lalatoto-app__heading">
        {%- if heading_line_1 != blank -%}<span class="lalatoto-app__line">{{ heading_line_1 | escape }}</span>{%- endif -%}
        {%- if heading_line_2 != blank -%}<span class="lalatoto-app__line">{{ heading_line_2 | escape }}</span>{%- endif -%}
      </h2>

      {%- if text != blank -%}
        <p class="lalatoto-app__text">{{ text | escape }}</p>
      {%- endif -%}

      <div class="lalatoto-app__buttons">
        {%- comment -%}Lalatoto: butiksknapper med Apples og Google Plays logo, i lalatotos farver{%- endcomment -%}
        <a href="{{ app_store_url }}" class="lalatoto-store-button lalatoto-store-button--solid lalatoto-app__button lalatoto-app__button--ios" target="_blank" rel="noopener">
          <svg class="lalatoto-store-button__logo" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M16.37 12.6c-.02-2.3 1.88-3.4 1.96-3.46-1.07-1.56-2.73-1.78-3.32-1.8-1.41-.14-2.76.83-3.48.83-.72 0-1.82-.81-3-.79-1.54.02-2.96.9-3.76 2.27-1.6 2.78-.41 6.9 1.15 9.15.76 1.1 1.67 2.34 2.86 2.3 1.15-.05 1.58-.74 2.97-.74 1.38 0 1.78.74 2.99.72 1.24-.02 2.02-1.12 2.78-2.23.87-1.28 1.23-2.52 1.25-2.58-.03-.01-2.39-.92-2.4-3.67zM14.1 5.86c.63-.77 1.06-1.83.94-2.89-.91.04-2.02.61-2.67 1.37-.58.67-1.1 1.76-.96 2.8 1.02.08 2.06-.52 2.69-1.28z" fill="currentColor"/>
          </svg>
          <span class="lalatoto-store-button__text">
            <span class="lalatoto-store-button__kicker">{{ 'lalatoto.app.app_store_kicker' | t }}</span>
            <span class="lalatoto-store-button__name">{{ 'lalatoto.app.app_store' | t }}</span>
          </span>
        </a>
        <a href="{{ google_play_url }}" class="lalatoto-store-button lalatoto-app__button lalatoto-app__button--android" target="_blank" rel="noopener">
          <svg class="lalatoto-store-button__logo" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4.6 2.9c-.24.25-.38.64-.38 1.13v15.94c0 .5.14.88.38 1.13l.06.06 8.93-8.93v-.22L4.66 2.84l-.06.06z" fill="currentColor" opacity=".9"/>
            <path d="M16.57 15.2l-2.98-2.98v-.22l2.98-2.98.07.04 3.53 2c1 .57 1 1.51 0 2.08l-3.53 2-.07.06z" fill="currentColor" opacity=".7"/>
            <path d="M16.64 15.16L13.59 12.1l-8.99 9c.33.35.88.4 1.5.05l10.54-5.99" fill="currentColor" opacity=".55"/>
            <path d="M16.64 9.06L6.1 3.07c-.62-.35-1.17-.31-1.5.05l8.99 8.98 3.05-3.04z" fill="currentColor" opacity=".8"/>
          </svg>
          <span class="lalatoto-store-button__text">
            <span class="lalatoto-store-button__kicker">{{ 'lalatoto.app.google_play_kicker' | t }}</span>
            <span class="lalatoto-store-button__name">{{ 'lalatoto.app.google_play' | t }}</span>
          </span>
        </a>
      </div>
    </div>

    <div class="lalatoto-app__phones">
      {%- for i in (1..2) -%}
        {%- liquid
          if i == 1
            assign image = section.settings.image_1
            assign fallback = 'lalatoto-app-phone-1.jpg'
            assign alt = 'lalatoto.app.image_1_alt' | t
          else
            assign image = section.settings.image_2
            assign fallback = 'lalatoto-app-phone-2.jpg'
            assign alt = 'lalatoto.app.image_2_alt' | t
          endif
        -%}
        {%- comment -%}Samme ramme som cns-phones på clubnosleep.com: ramme > skærm > billede{%- endcomment -%}
        <div class="lalatoto-app__phone lalatoto-app__phone--{{ i }}">
          <div class="lalatoto-app__screen">
            {%- if image != blank -%}
              {%- assign image_alt = image.alt | default: alt -%}
              {{-
                image
                | image_url: width: 700
                | image_tag:
                  loading: 'lazy',
                  sizes: '232px',
                  widths: '240,480,700',
                  alt: image_alt
              -}}
            {%- else -%}
              <img src="{{ fallback | asset_url }}" alt="{{ alt | escape }}" width="420" height="910" loading="lazy">
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('lalatoto-app-{{ section.id }}');
    if (!root) return;

    var ua = navigator.userAgent || '';
    /* iPadOS udgiver sig for at være en Mac, men har berøringsskærm. */
    var isIos = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
    var isAndroid = /Android/i.test(ua);

    if (isIos) root.setAttribute('data-platform', 'ios');
    else if (isAndroid) root.setAttribute('data-platform', 'android');
  })();
</script>

{% schema %}
{
  "name": "Lalatoto app",
  "class": "shopify-section--lalatoto-app",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Tomme tekstfelter viser temaets standardtekst, som oversættes via sprogfilerne. Skriver du en tekst her, oversættes den i Shopifys oversættelsesværktøj."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farveskema",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Etiket"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Overskrift, linje 1"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Overskrift, linje 2"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Telefon 1",
      "info": "Stående skærmbillede i iPhone-forhold (9:19,5). Anbefalet: 720 × 1560 px; et almindeligt iPhone-skærmbillede (1170 × 2532 px) går også. Vises kun ca. 232 px bredt, så større gør ingen forskel. Brug JPG (ikke PNG), sRGB, under ca. 200 KB. Shopify laver selv mindre udgaver og WebP; større end anbefalet gør kun siden langsommere."
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Telefon 2",
      "info": "Stående skærmbillede i iPhone-forhold (9:19,5). Anbefalet: 720 × 1560 px; et almindeligt iPhone-skærmbillede (1170 × 2532 px) går også. Vises kun ca. 232 px bredt, så større gør ingen forskel. Brug JPG (ikke PNG), sRGB, under ca. 200 KB. Shopify laver selv mindre udgaver og WebP; større end anbefalet gør kun siden langsommere."
    },
    {
      "type": "url",
      "id": "app_store_url",
      "label": "Link til App Store",
      "info": "Tomt felt: appens side i App Store."
    },
    {
      "type": "url",
      "id": "google_play_url",
      "label": "Link til Google Play",
      "info": "Tomt felt: appens side i Google Play."
    }
  ],
  "presets": [
    {
      "name": "Lalatoto app"
    }
  ]
}
{% endschema %}
