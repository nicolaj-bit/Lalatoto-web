{%- comment -%}
  Lalatoto: footer.

  Øverst tilmelding til nyhedsbrevet og fire kolonner: tre menuer (fx Shop,
  Om Lalatoto og Kundeservice) og kontakt. Alle starter med en lille etiket,
  så de står på linje. Nederst en bundlinje med copyright, en fjerde menu
  (vilkår) og sociale medier.

  Virksomhedens oplysninger (navn, adresse og CVR) står i bundlinjen på
  computer og under «Kontakt» på telefon.

  Tilmeldingen bruger Shopifys kundeformular. Kunden oprettes med mærkerne
  «newsletter», «nyhedsbrev» og «nyhedsbrev-samtykke». «newsletter» er det
  mærke, den gamle side bruger, så tilmeldingen ender i samme flow som før.
  Teksten under knappen siger tydeligt, at man tilmelder sig nyhedsbrevet,
  så selve tilmeldingen er samtykket. Der gives ingen velkomstrabat.
{%- endcomment -%}

{%- liquid
  assign form_id = 'lalatoto-newsletter-' | append: section.id
  assign privacy_url = section.settings.privacy_page.url | default: shop.privacy_policy.url
  assign phone_link = section.settings.phone | remove: ' ' | remove: '-'
  assign year = 'now' | date: '%Y'

  comment
    Teksterne i tilmeldingen rettes i temaeditoren. Tomme felter bruger
    standardteksten fra sprogfilerne.
  endcomment
  assign nl_title = section.settings.nl_title
  if nl_title == blank
    assign nl_title = 'lalatoto.footer.title_html' | t
  endif
  assign nl_text = section.settings.nl_text
  if nl_text == blank
    assign nl_text = 'lalatoto.footer.text' | t
  endif
  assign nl_button = section.settings.nl_button
  if nl_button == blank
    assign nl_button = 'lalatoto.footer.submit' | t
  endif
  assign nl_consent = section.settings.nl_consent
  if nl_consent == blank
    assign nl_consent = 'lalatoto.footer.consent' | t
  endif
  assign nl_done_title = section.settings.nl_done_title
  if nl_done_title == blank
    assign nl_done_title = 'lalatoto.footer.done_title' | t
  endif
  assign nl_done_text = section.settings.nl_done_text
  if nl_done_text == blank
    assign nl_done_text = 'lalatoto.footer.done_text' | t
  endif
-%}

<footer class="lalatoto-footer color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <div class="lalatoto-footer__inner">
    <div class="lalatoto-footer__columns">
      {%- comment -%} Nyhedsbrev {%- endcomment -%}
      <div class="lalatoto-footer__col lalatoto-footer__col--newsletter">
        <p class="lalatoto-footer__heading">{{ 'lalatoto.footer.kicker' | t }}</p>
        <h2 class="lalatoto-footer__nl-title">{{ nl_title }}</h2>
        <p class="lalatoto-footer__muted">{{ nl_text | escape }}</p>

        {%- form 'customer', id: form_id, class: 'lalatoto-footer__form' -%}
          {%- liquid
            assign done = false
            if form.posted_successfully?
              assign done = true
            endif
          -%}
          <div class="lalatoto-footer__form-inner{% if done %} is-done{% endif %}" data-lalatoto-posted="{{ done }}" data-form-id="{{ form_id }}">
            <div class="lalatoto-footer__fields">
              <input type="hidden" name="contact[tags]" value="newsletter,nyhedsbrev,nyhedsbrev-samtykke">

              <div class="lalatoto-footer__lines">
                <div class="lalatoto-footer__line">
                  <label for="{{ form_id }}-name">{{ 'lalatoto.footer.name_label' | t }}</label>
                  <input
                    type="text"
                    id="{{ form_id }}-name"
                    name="contact[first_name]"
                    autocomplete="given-name"
                    required
                  >
                </div>

                <div class="lalatoto-footer__line{% if form.errors %} has-error{% endif %}">
                  <label for="{{ form_id }}-email">{{ 'lalatoto.footer.email_label' | t }}</label>
                  <input
                    type="email"
                    id="{{ form_id }}-email"
                    name="contact[email]"
                    autocomplete="email"
                    inputmode="email"
                    spellcheck="false"
                    required
                    {% if form.errors %}
                      aria-invalid="true" aria-describedby="{{ form_id }}-error"
                    {% endif %}
                  >
                </div>
              </div>

              {%- if form.errors -%}
                <p class="lalatoto-waitlist__error" id="{{ form_id }}-error">{{ 'lalatoto.footer.error' | t }}</p>
              {%- endif -%}

              <button type="submit" class="lalatoto-footer__nl-button">{{ nl_button | escape }}</button>

              <p class="lalatoto-footer__fine">
                {{ nl_consent | escape }}
                {%- if privacy_url != blank %}
                  <a href="{{ privacy_url }}">{{ 'lalatoto.footer.privacy_link' | t }}</a>.
                {%- endif -%}
              </p>
            </div>

            <div class="lalatoto-footer__done" role="status">
              <p class="lalatoto-footer__done-title">{{ nl_done_title | escape }}</p>
              <p class="lalatoto-footer__muted">{{ nl_done_text | escape }}</p>
            </div>
          </div>
        {%- endform -%}
      </div>

      <div class="lalatoto-footer__groups">
        {%- for menu_key in (1..3) -%}
          {%- liquid
            case menu_key
              when 1
                assign menu = section.settings.menu_1
              when 2
                assign menu = section.settings.menu_2
              else
                assign menu = section.settings.menu_3
            endcase
          -%}
          {%- if menu != blank and menu.links.size > 0 -%}
            <details class="lalatoto-footer__col lalatoto-footer__group" data-lalatoto-footer-group open>
              <summary class="lalatoto-footer__heading">
                {{- menu.title -}}
                <span class="lalatoto-footer__plus" aria-hidden="true"></span>
              </summary>
              <nav aria-label="{{ menu.title | escape }}">
                <ul class="lalatoto-footer__list unstyled-list" role="list">
                  {%- for link in menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </nav>
            </details>
          {%- endif -%}
        {%- endfor -%}

        <details class="lalatoto-footer__col lalatoto-footer__group" data-lalatoto-footer-group open>
          <summary class="lalatoto-footer__heading">
            {{- 'lalatoto.footer.contact_heading' | t -}}
            <span class="lalatoto-footer__plus" aria-hidden="true"></span>
          </summary>
          <div class="lalatoto-footer__group-body">
            <address class="lalatoto-footer__address">
              {%- comment -%} Navn, adresse og CVR: her på telefon, i bundlinjen på computer {%- endcomment -%}
              <span class="lalatoto-footer__company">
                {%- if section.settings.company != blank -%}
                  <span>{{ section.settings.company }}</span>
                {%- endif -%}
                {%- if section.settings.address != blank -%}
                  <span class="lalatoto-footer__muted">{{ section.settings.address | newline_to_br }}</span>
                {%- endif -%}
                {%- if section.settings.cvr != blank -%}
                  <span class="lalatoto-footer__muted">{{ 'lalatoto.footer.cvr' | t }} {{ section.settings.cvr }}</span>
                {%- endif -%}
              </span>
              {%- if section.settings.email != blank -%}
                <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
              {%- endif -%}
              {%- if section.settings.phone != blank -%}
                <a href="tel:{{ phone_link }}">{{ section.settings.phone }}</a>
              {%- endif -%}
            </address>

            {%- if section.settings.hours != blank -%}
              <p class="lalatoto-footer__heading lalatoto-footer__heading--sub">{{ 'lalatoto.footer.hours_heading' | t }}</p>
              <p class="lalatoto-footer__muted">{{ section.settings.hours | newline_to_br }}</p>
            {%- endif -%}
          </div>
        </details>
      </div>
    </div>

    {%- comment -%} Bundlinje {%- endcomment -%}
    <div class="lalatoto-footer__bottom">
      <p class="lalatoto-footer__copy">
        <span>© {{ year }} {{ section.settings.company | default: shop.name }}</span>
        {%- if section.settings.address != blank -%}
          <span class="lalatoto-footer__copy-extra">{{ section.settings.address | strip | newline_to_br | replace: '<br />', ', ' | strip_newlines }}</span>
        {%- endif -%}
        {%- if section.settings.cvr != blank -%}
          <span class="lalatoto-footer__copy-extra">{{ 'lalatoto.footer.cvr' | t }} {{ section.settings.cvr }}</span>
        {%- endif -%}
      </p>

      {%- assign legal_menu = section.settings.legal_menu -%}
      {%- if legal_menu != blank and legal_menu.links.size > 0 -%}
        <nav class="lalatoto-footer__legal" aria-label="{{ legal_menu.title | escape }}">
          <ul class="unstyled-list" role="list">
            {%- for link in legal_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      {%- if section.settings.show_social_media -%}
        {%- render 'social-media', layout: 'list' -%}
      {%- endif -%}

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="payment-methods unstyled-list" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{- type | payment_type_svg_tag -}}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

<script>
  /*
   * Desuden: Shopify markerer alle kundeformularer på siden som sendt, når én af dem er
   * sendt, fx ventelisten. Efter afsendelse ender adressen på formularens id,
   * så takken vises kun i den formular, der faktisk blev sendt.
   */
  (function () {
    /* Menuer og kontakt: foldet sammen på telefon, altid åbne på computer */
    var wide = window.matchMedia('(min-width: 1000px)');
    var groups = document.querySelectorAll('[data-lalatoto-footer-group]');
    function sync() {
      groups.forEach(function (group) {
        group.open = wide.matches;
      });
    }
    sync();
    wide.addEventListener('change', sync);
    groups.forEach(function (group) {
      group.querySelector('summary').addEventListener('click', function (event) {
        if (wide.matches) event.preventDefault();
      });
    });

    document.querySelectorAll('[data-lalatoto-posted="true"]').forEach(function (element) {
      if (window.location.hash !== '#' + element.getAttribute('data-form-id')) {
        element.classList.remove('is-done');
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Lalatoto footer",
  "class": "shopify-section--lalatoto-footer shopify-section--footer",
  "tag": "section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farveskema",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Nyhedsbrev"
    },
    {
      "type": "inline_richtext",
      "id": "nl_title",
      "label": "Overskrift",
      "info": "Kursiv markerer den del, der står i skrå skrift."
    },
    {
      "type": "textarea",
      "id": "nl_text",
      "label": "Tekst"
    },
    {
      "type": "text",
      "id": "nl_button",
      "label": "Knap"
    },
    {
      "type": "textarea",
      "id": "nl_consent",
      "label": "Tekst under knappen",
      "info": "Skal fortælle tydeligt, at man tilmelder sig nyhedsbrevet. Linket til persondatapolitikken sættes på automatisk."
    },
    {
      "type": "text",
      "id": "nl_done_title",
      "label": "Tak: overskrift"
    },
    {
      "type": "text",
      "id": "nl_done_text",
      "label": "Tak: tekst"
    },
    {
      "type": "header",
      "content": "Menuer"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Første menu"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Anden menu"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Tredje menu"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Menu i bundlinjen",
      "info": "Fx handelsbetingelser, persondatapolitik og cookies."
    },
    {
      "type": "page",
      "id": "privacy_page",
      "label": "Side med persondatapolitik",
      "info": "Linkes fra teksten under tilmeldingen. Tom: Shopifys egen politik."
    },
    {
      "type": "header",
      "content": "Virksomhedens oplysninger"
    },
    {
      "type": "text",
      "id": "company",
      "label": "Firmanavn"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Adresse"
    },
    {
      "type": "text",
      "id": "cvr",
      "label": "CVR-nummer"
    },
    {
      "type": "text",
      "id": "email",
      "label": "E-mail"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Telefon"
    },
    {
      "type": "textarea",
      "id": "hours",
      "label": "Åbningstider",
      "info": "Én linje pr. dag eller periode."
    },
    {
      "type": "header",
      "content": "Bundlinje"
    },
    {
      "type": "checkbox",
      "id": "show_social_media",
      "label": "Vis sociale medier",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Vis betalingsikoner",
      "default": true
    }
  ]
}
{% endschema %}
