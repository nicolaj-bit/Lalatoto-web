{%- comment -%}
  Lalatoto: én artikel i journalen.

  Øverst en lille etiket (første emne, ellers journalens navn), titel i
  Playfair og en linje med dato, forfatter og læsetid. Derefter artiklens
  billede i fuld bredde og selve teksten i en rolig læsebredde, med et kort
  om Club No Sleep inde i teksten. Nederst emner, et link tilbage, «Fra
  artiklen» med op til tre produkter og tre artikler under «Læs også»:
  helst med samme emne, ellers de nyeste.

  Tekst indsat fra Word har ofte sine egne skrifttyper og størrelser.
  De fjernes i CSS, så alle artikler ser ens ud.
{%- endcomment -%}

{%- liquid
  assign words = article.content | strip_html | split: ' ' | size
  assign minutes = words | divided_by: 200 | at_least: 1
  assign kicker = article.tags.first | default: blog.title
  assign kicker_url = blog.url
  if article.tags.first != blank
    assign tag_handle = article.tags.first | handleize
    assign kicker_url = blog.url | append: '/tagged/' | append: tag_handle
  endif
-%}

{{ 'lalatoto-article-product.css' | asset_url | stylesheet_tag }}

<article class="lalatoto-article color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <header class="lalatoto-article__head">
    <a href="{{ kicker_url }}" class="lalatoto-kicker lalatoto-article__kicker">{{ kicker | escape }}</a>
    <h1 class="lalatoto-article__title">{{ article.title | escape }}</h1>
    <p class="lalatoto-article__meta">
      {{- article.published_at | time_tag: format: 'date' -}}
      {%- if section.settings.show_author and article.author != blank -%}
        <span aria-hidden="true">·</span>{{ article.author }}
      {%- endif -%}
      <span aria-hidden="true">·</span>
      {{- 'lalatoto.journal.reading_time' | t: minutes: minutes -}}
    </p>
  </header>

  {%- if article.image -%}
    <div class="lalatoto-article__media">
      {{-
        article.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '(max-width: 1400px) 100vw, 1400px',
          widths: '600,800,1000,1200,1600,2000,2400',
          alt: article.image.alt
      -}}
    </div>
  {%- endif -%}

  {%- liquid
    comment
      Club No Sleep: kortet lægges ind efter ca. en tredjedel af teksten
      (efter mindst to afsnit). Appen er på dansk, så kortet vises kun på
      den danske side, og det kan skjules pr. artikel med metafeltet
      «Skjul Club No Sleep» (lalatoto.skjul_app).
    endcomment
    assign show_app = false
    if section.settings.show_app and request.locale.iso_code == 'da' and article.metafields.lalatoto.skjul_app.value != true
      assign show_app = true
    endif

    assign paragraphs = article.content | split: '</p>'
    assign app_after = paragraphs.size | divided_by: 3 | at_least: 2
    if paragraphs.size <= app_after
      assign app_after = -1
    endif

    comment
      Produktkortet lægges ind efter ca. to tredjedele af teksten, altid
      efter appens kort. Er artiklen for kort, kommer det til sidst.
    endcomment
    assign show_product = section.settings.show_product
    assign product_after = paragraphs.size | times: 2 | divided_by: 3
    if product_after <= app_after
      assign product_after = app_after | plus: 1
    endif
    if paragraphs.size <= product_after
      assign product_after = -1
    endif
  -%}

  <div class="lalatoto-article__body">
    {%- for part in paragraphs -%}
      {{- part -}}{%- unless forloop.last -%}</p>{%- endunless -%}
      {%- if show_app and forloop.index == app_after -%}
        {%- render 'lalatoto-article-app', section: section -%}
      {%- endif -%}
      {%- if show_product and forloop.index == product_after -%}
        {%- render 'lalatoto-article-product', article: article -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if show_app and app_after < 1 -%}
      {%- render 'lalatoto-article-app', section: section -%}
    {%- endif -%}
    {%- if show_product and product_after < 1 -%}
      {%- render 'lalatoto-article-product', article: article -%}
    {%- endif -%}
  </div>

  <footer class="lalatoto-article__foot">
    {%- if article.tags.size > 0 -%}
      <ul class="lalatoto-article__tags unstyled-list" role="list">
        {%- for tag in article.tags -%}
          <li><a href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    <a href="{{ blog.url }}" class="lalatoto-article__back">
      <span aria-hidden="true">←</span> {{ 'lalatoto.journal.back' | t: blog: blog.title }}
    </a>
  </footer>
</article>

{%- if section.settings.show_shop -%}
  {%- render 'lalatoto-article-shop', article: article, section: section -%}
{%- endif -%}

{%- if section.settings.show_related -%}
  {%- liquid
    comment
      «Læs også»: først artikler med samme emne, derefter de nyeste. Den
      aktuelle artikel springes over.
    endcomment
    assign related_handles = ''
    assign related_count = 0
    assign first_tag = article.tags.first
  -%}
  {%- capture related_cards -%}
    {%- if first_tag != blank -%}
      {%- for other in blog.articles -%}
        {%- if related_count >= 3 -%}{%- break -%}{%- endif -%}
        {%- if other.id != article.id and other.tags contains first_tag -%}
          {%- render 'lalatoto-article-card', article: other, show_excerpt: false -%}
          {%- assign related_handles = related_handles | append: '|' | append: other.handle | append: '|' -%}
          {%- assign related_count = related_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    {%- for other in blog.articles -%}
      {%- if related_count >= 3 -%}{%- break -%}{%- endif -%}
      {%- assign key = '|' | append: other.handle | append: '|' -%}
      {%- if other.id != article.id -%}
        {%- unless related_handles contains key -%}
          {%- render 'lalatoto-article-card', article: other, show_excerpt: false -%}
          {%- assign related_handles = related_handles | append: key -%}
          {%- assign related_count = related_count | plus: 1 -%}
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if related_count > 0 -%}
    <aside class="lalatoto-article-related color-scheme color-scheme--{{ section.settings.color_scheme.id }}" aria-labelledby="lalatoto-related-{{ section.id }}">
      <h2 class="lalatoto-kicker lalatoto-article-related__title" id="lalatoto-related-{{ section.id }}">{{ 'lalatoto.journal.related' | t }}</h2>
      <div class="lalatoto-article-related__grid">
        {{ related_cards }}
      </div>
    </aside>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Lalatoto artikel",
  "class": "shopify-section--lalatoto-article",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farveskema",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Vis forfatter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_related",
      "label": "Vis «Læs også» nederst",
      "default": true
    },
    {
      "type": "header",
      "content": "Club No Sleep i artiklen"
    },
    {
      "type": "checkbox",
      "id": "show_app",
      "label": "Vis kort om appen",
      "info": "Lægges ind efter ca. en tredjedel af teksten, kun på dansk. Skjules i en enkelt artikel med metafeltet «Skjul Club No Sleep».",
      "default": true
    },
    {
      "type": "url",
      "id": "app_store_url",
      "label": "Link til App Store",
      "info": "Tom: Club No Sleep i App Store."
    },
    {
      "type": "url",
      "id": "google_play_url",
      "label": "Link til Google Play",
      "info": "Tom: Club No Sleep i Google Play."
    },
    {
      "type": "url",
      "id": "app_site_url",
      "label": "Link til hjemmesiden",
      "info": "Tom: clubnosleep.com."
    },
    {
      "type": "header",
      "content": "Produkt i teksten"
    },
    {
      "type": "checkbox",
      "id": "show_product",
      "label": "Vis et produkt inde i teksten",
      "info": "Lægges ind efter ca. to tredjedele af teksten. Produktet er det første i artiklens metafelt «Produkter til artiklen», ellers sengerand, sengetøj eller luksus sengeslange efter artiklens emne. Er det udsolgt, fører knappen til ventelisten.",
      "default": true
    },
    {
      "type": "header",
      "content": "Fra artiklen"
    },
    {
      "type": "checkbox",
      "id": "show_shop",
      "label": "Vis produkter nederst",
      "info": "Op til tre: først artiklens metafelt «Produkter til artiklen», så produkter, artiklen nævner, og til sidst standardprodukterne herunder (tom: kollektionen «produkter»).",
      "default": true
    },
    {
      "type": "text",
      "id": "shop_heading",
      "label": "Overskrift",
      "info": "Tom: «Mere ro i sengen»."
    },
    {
      "type": "product_list",
      "id": "shop_products",
      "label": "Standardprodukter",
      "limit": 3
    },
    {
      "type": "paragraph",
      "content": "Artiklens tekst og billede rettes på selve artiklen under Onlinebutik → Blogindlæg. Billede: 2400 × 1600 px (3:2, liggende), JPG, under ca. 400 KB."
    }
  ]
}
{% endschema %}
