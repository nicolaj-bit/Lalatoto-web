<style>
  .Trustreviews_wrapper {
    position: relative;
    width: 100%;
  }

  .Trustreviews_header {
    text-align: center;
    font-weight: 500;
    color: #333;
    margin-top: 40px;
    margin-bottom: 20px;
    font-family: 'Univers Next', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  h1.Trustreviews_header { font-size: 32px; }
  h2.Trustreviews_header { font-size: 28px; }
  h3.Trustreviews_header { font-size: 24px; }
  h4.Trustreviews_header { font-size: 20px; }

  .Trustreviews_main {
    width: calc(100% - 80px);
    height: auto;
    position: relative;
    padding: 0 40px;
    overflow: hidden;
    display: flex;
    scroll-snap-type: x mandatory;
    gap: 20px;
    margin: 0 auto;
    scroll-behavior: smooth;
  }

  .Trustreviews_con {
    min-width: 48%;
    background-color: #F8F3ED;
    padding: 20px;
    margin: 40px 0;
    border-radius: 10px;
    display: inline-block;
    scroll-snap-align: center;
    box-sizing: border-box;
  }

  .Trustreviews_info {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .Trustreviews_info p {
    font-size: 16px;
    font-weight: 600;
    color: #121212;
    padding: 8px 0;
    border-bottom: 1px solid rgba(0,0,0,0.3);
    margin: 0;
    width: 100%;
    text-align: left;
  }

  .Trustreviews_trust {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 0;
  }

  .Trustreviews_trust span {
    font-size: 12px;
  }

  .Trustreviews_alltxt {
    text-align: left;
    overflow: hidden;
    max-height: 8em;
    transition: max-height 0.3s ease;
  }

  .Trustreviews_alltxt p {
    font-weight: 400;
    border: none;
  }

  .dateP {
    font-size: 16px !important;
    font-weight: 600 !important;
  }

  .dateSPAN {
    font-size: 14px !important;
    font-weight: 400 !important;
  }

  .read-more-container {
    position: relative;
  }

  .read-more-trigger {
    display: none;
  }

  .read-more-label {
    cursor: pointer;
    color: black;
    text-decoration: underline;
    display: block;
    text-align: left;
  }

  .read-more-trigger:checked ~ .Trustreviews_alltxt {
    max-height: none;
  }

  .read-more-trigger:checked ~ .read-more-label::after {
    content: ' Læs mindre';
  }

  .read-more-label::after {
    content: ' Læs mere';
  }

  .Trustreviews_rating {
    text-align: center;
    font-size: 14px;
    color: #000;
    margin-top: 20px;
  }

  .Trustreviews_rating a {
    color: #000;
    text-decoration: none;
  }

  .Trustreviews_rating a:hover {
    text-decoration: underline;
  }

  .custom-stars svg {
    width: 20px;
    height: 20px;
    fill: #FFD700; /* Trustpilot grøn */
    margin-right: 2px;
    display: inline-block;
    vertical-align: middle;
  }

  @media screen and (max-width: 1040px) {
    .Trustreviews_con {
      min-width: 100%;
    }
    .Trustreviews_main {
      width: 100%;
    }
    .arrow {
      display: none !important;
    }
  }

  @media screen and (min-width: 1041px) {
    .Trustreviews_main {
      max-height: 600px;
    }
    .arrow {
      display: block;
    }
  }

  .arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    cursor: pointer;
    z-index: 1000;
    width: 40px;
    height: 40px;
    background-color: #fff;
    border: 1px solid #ccc;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 0 5px rgba(0,0,0,0.2);
  }

  .arrow-left { left: 10px; }
  .arrow-right { right: 10px; }

  .arrow::before {
    content: '';
    width: 10px;
    height: 10px;
    border-top: 2px solid #333;
    border-right: 2px solid #333;
  }

  .arrow-left::before { transform: rotate(-135deg); }
  .arrow-right::before { transform: rotate(45deg); }
</style>

<div class="Trustreviews_wrapper">
  {% assign heading_tag = section.settings.heading_level | default: "h3" %}
  <{{ heading_tag }} class="Trustreviews_header">
    {% if request.locale.iso_code == "en" and section.settings.header_text_en != blank %}
      {{ section.settings.header_text_en }}
    {% elsif request.locale.iso_code == "da" and section.settings.header_text_da != blank %}
      {{ section.settings.header_text_da }}
    {% elsif request.locale.iso_code == "en" %}
      Loved by those who knows best – our customers!
    {% else %}
      Vores kunder siger det bedre, end vi selv kan
    {% endif %}
  </{{ heading_tag }}>

  <div class="Trustreviews_rating">
      {{ section.settings.rating_text }}
    <span class="custom-stars">
      {% for i in (1..5) %}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
          <polygon points="10,1 12.59,6.84 18.82,7.27 14,11.51 15.18,17.68 10,14.5 4.82,17.68 6,11.51 1.18,7.27 7.41,6.84" />
        </svg>
      {% endfor %}
    </span>
  </div>

  <div class="arrow arrow-left" id="arrow-left"></div>
  <div class="Trustreviews_main" id="Trustreviews_main">
    {% for block in section.blocks %}
      <div class="Trustreviews_con">
        <div class="Trustreviews_info">
          <p>{{ block.settings.name }}</p>
          <div class="Trustreviews_trust">
            <span class="custom-stars">
              {% for i in (1..5) %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                  <polygon points="10,1 12.59,6.84 18.82,7.27 14,11.51 15.18,17.68 10,14.5 4.82,17.68 6,11.51 1.18,7.27 7.41,6.84" />
                </svg>
              {% endfor %}
            </span>
            <span>{{ block.settings.date }}</span>
          </div>
          <div class="read-more-container">
            <input type="checkbox" class="read-more-trigger" id="read-more-{{ forloop.index }}">
            <div class="Trustreviews_alltxt">
              {{ block.settings.des }}
              <p class="dateP">Dato for oplevelse: <span class="dateSPAN">{{ block.settings.date }}</span></p>
            </div>
            <label for="read-more-{{ forloop.index }}" class="read-more-label"></label>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
  <div class="arrow arrow-right" id="arrow-right"></div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const container = document.getElementById('Trustreviews_main');
  const arrowLeft = document.getElementById('arrow-left');
  const arrowRight = document.getElementById('arrow-right');
  const scrollAmount = container.scrollWidth / container.childElementCount;
  let scrollPosition = 0;
  let interval;
  let timeout;

  function startScrolling() {
    interval = setInterval(() => {
      scrollPosition += scrollAmount;
      if (scrollPosition >= container.scrollWidth) {
        scrollPosition = 0;
      }
      container.scroll({
        left: scrollPosition,
        behavior: 'smooth'
      });
    }, 5000);
  }

  function stopScrolling() {
    clearInterval(interval);
    clearTimeout(timeout);
  }

  function restartScrolling() {
    stopScrolling();
    timeout = setTimeout(startScrolling, 30000);
  }

  function scrollLeft() {
    stopScrolling();
    scrollPosition -= scrollAmount;
    if (scrollPosition < 0) {
      scrollPosition = container.scrollWidth - scrollAmount;
    }
    container.scroll({
      left: scrollPosition,
      behavior: 'smooth'
    });
    restartScrolling();
  }

  function scrollRight() {
    stopScrolling();
    scrollPosition += scrollAmount;
    if (scrollPosition >= container.scrollWidth) {
      scrollPosition = 0;
    }
    container.scroll({
      left: scrollPosition,
      behavior: 'smooth'
    });
    restartScrolling();
  }

  startScrolling();
  arrowLeft.addEventListener('click', scrollLeft);
  arrowRight.addEventListener('click', scrollRight);
});
</script>



{% schema %}
{
  "name": "Trustreviews",
  "settings": [
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "Læs vores kundeanmeldelser"
    },
    {
      "type": "text",
      "id": "header_text_da",
      "label": "Dansk overskrift",
      "default": "Vores kunder siger det bedre, end vi selv kan"
    },
    {
      "type": "text",
      "id": "header_text_en",
      "label": "Engelsk overskrift",
      "default": "Loved by those who knows best – our customers!"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Overskriftsniveau (H-tag)",
      "default": "h3",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "custom",
      "name": "Anmeldelser",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Name"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "10 May 2023"
        },
        {
          "type": "richtext",
          "id": "des",
          "label": "Description"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "category": "custom",
      "name": "Trustreviews"
    }
  ]
}
{% endschema %}