<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<style>
    .CD_storyLine_main{width: 100%;height: auto;position: relative;display: flex;justify-content: center;}
    .CD_storyLine_in{width: 1280px;height: auto;padding:20px;position: relative;}
    .CD_storyLine_con{padding: 30px;position: relative;width:50%;background-color: rgba(0,0,0,0);}
    .CD_storyLine_info_con{padding: 20px;background-color: #F8F3ED;border-radius: 5px;width: 100%;height: auto;}
    .CD_storyLine_info_img{width: 100%;height: auto;}
    .CD_storyLine_info_img img{width: 100%;height:100%;object-fit: cover;display: flex;border-radius:5px;}
    .CD_storyLine_info_txt{width: 100%;height: auto;margin-top: 20px;}
    .CD_storyLine_info_txt h2{width: 100%;text-align: left;font-size:27px;color:#1d3145;font-family: Univers Next, Univers Next;font-weight: 500;}
    .CD_storyLine_info_txt p{width: 100%;height: auto;text-align:left;font-size: 16px;color: #000;}
    .CD_storyLine_in .CD_storyLine_con:nth-child(even){left: 0;}
    .CD_storyLine_in .CD_storyLine_con:nth-child(odd){left: 50%;}
    .CD_storyLine_in .CD_storyLine_con:nth-child(odd) .CD_stroyLine_P{width:40px;height: 40px;background-color: #e8e4df;border-radius: 40px;position: absolute;left: -20px;}
    .CD_storyLine_in .CD_storyLine_con:nth-child(even) .CD_stroyLine_P{width:40px;height: 40px;background-color: #e8e4df;border-radius: 40px;position: absolute;right: -20px;}
    .CD_storyLine_in::after{content: "";position: absolute;left: calc(50% - 2px);top:0;width: 4px;height: 100%;background-color: #e8e4df;z-index: 0;}
    @media screen and (max-width: 1320px){
        .CD_storyLine_in{width: 100%;}
    }
    @media screen and (max-width: 800px){
        .CD_storyLine_in::after{content: "";left: 20px;}
        .CD_storyLine_in .CD_storyLine_con:nth-child(odd){left: 0;}
        .CD_storyLine_in .CD_storyLine_con:nth-child(odd) .CD_stroyLine_P{left: -8px;width: 20px;height: 20px;}
        .CD_storyLine_in .CD_storyLine_con:nth-child(even) .CD_stroyLine_P{left: -8px;width: 20px;height: 20px;}
        .CD_storyLine_con{width: 100%;}
        .CD_storyLine_info_con{padding: 10px;}
        .CD_storyLine_info_txt h2{font-size: 24px;}
    }
</style>

<div class="CD_storyLine_main">
  <div class="CD_storyLine_in">
    {%- for block in section.blocks -%}
    <div class="CD_storyLine_con" >
        <p class="CD_stroyLine_P" data-aos="zoom-in" data-aos-offset="150"></p>
        <div class="CD_storyLine_info_con low-dark" data-aos="zoom-in" data-aos-offset="150" data-aos-delay="300">
            {%- if block.settings.image != blank -%}
            <div class="CD_storyLine_info_img">
                <img src="{{block.settings.image | img_url: '800x'}}" alt="" loading="lazy">
            </div>
            {%- endif -%}
            <div class="CD_storyLine_info_txt">
               <p>{{block.settings.date}}</p>
                <h2>{{block.settings.heading}}</h2>
                <p>{{block.settings.para}}</p>
            </div>
        </div>
    </div>    
    {%- endfor -%}
  </div>
</div>
<script>
  AOS.init();
</script>
{% schema %}
{
    "name": "CD Story Line",
    "settings": [

                ],
    "blocks": [
                    {
                        "type": "Image",
                        "name": "Story Line Block",
                        "settings": [
                                        {
                                            "type": "text",
                                            "id": "date",
                                            "label": "Date",
                                            "default": "21-jun-2023"
                                        },
                                        {
                                            "type": "image_picker",
                                            "id": "image",
                                            "label": "Image"
                                        },
                                        {
                                            "type": "text",
                                            "id": "heading",
                                            "label": "Heading",
                                            "default": "Heading"
                                        },
                                        {
                                            "type": "textarea",
                                            "id": "para",
                                            "label": "Paragraph"
                                        },
                                        {
                                            "type": "select",
                                            "id": "side",
                                            "label": "Side",
                                            "options": [
                                                {
                                                    "value": "Left",
                                                    "label": "Left"
                                                },
                                                {
                                                    "value": "Right",
                                                    "label": "Right"
                                                }
                                            ]
                                        }
                                    ]
                    }
                ],
    "presets": [
        {
            "category": "custom",
            "name":"CD Story Line"
        }
    ]
}
{% endschema %}