{%- comment -%}
  Lalatoto: nederst på produktsiden, over FAQ'en.

  1. Billede med en kort tekst om materialerne og et link til
     materialesiden – samme opbygning og stil som «billede med tekst» på
     forsiden (lalatoto-image-text). Billedet vælges i temaeditoren; er det tomt,
     bruges produktets tredje (ellers andet) billede.
  2. «Andre kiggede også på»: produkter fra kollektionen «produkter»
     (kan ændres i temaeditoren), valgt automatisk og vist med overskrift
     og kort som «Shop» på forsiden (lalatoto-featured).

  Teksterne står i sprogfilerne (lalatoto.product_more.*) og kan rettes i
  temaeditoren.
{%- endcomment -%}

{%- liquid
  assign image = section.settings.image
  if image == blank
    assign media_index = 2
    if product.media.size < 3
      assign media_index = 1
    endif
    assign candidate = product.media[media_index]
    if candidate.media_type == 'image'
      assign image = candidate
    endif
  endif

  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'lalatoto.product_more.heading_html' | t
  endif
  assign text = section.settings.text
  if text == blank
    assign text = 'lalatoto.product_more.text' | t
  endif
  assign link_label = section.settings.link_label
  if link_label == blank
    assign link_label = 'lalatoto.product_more.link' | t
  endif
  assign link_url = section.settings.link_url
  if link_url == blank
    assign link_url = pages.materialer.url | default: routes.root_url
  endif
  assign related_heading = section.settings.related_heading
  if related_heading == blank
    assign related_heading = 'lalatoto.product_more.related' | t
  endif
-%}

<div class="lalatoto-more color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  {%- if section.settings.show_story -%}
    {%- comment -%} Samme opbygning og stil som «billede med tekst» på forsiden {%- endcomment -%}
    <div class="lalatoto-image-text">
      <div class="lalatoto-image-text__media">
        {%- if image != blank -%}
          {{- image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 55vw, 100vw', widths: '600,800,1000,1200,1400,1600', alt: '' -}}
        {%- else -%}
          {{- 'lifestyle-2' | placeholder_svg_tag: 'placeholder' -}}
        {%- endif -%}
      </div>
      <div class="lalatoto-image-text__content">
        {%- if section.settings.kicker != blank -%}
          <p class="lalatoto-kicker">{{ section.settings.kicker | escape }}</p>
        {%- endif -%}
        <h2 class="lalatoto-image-text__title">{{ heading }}</h2>
        <div class="lalatoto-image-text__text"><p>{{ text | escape }}</p></div>
        <a href="{{ link_url }}" class="lalatoto-image-text__link">{{ link_label | escape }}</a>
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.show_related -%}
    {%- liquid
      comment
        Produkterne tages fra kollektionen (standard «produkter»). Det viste
        produkt springes over, og listen starter lige efter det i
        kollektionen, så hver produktside viser sine «naboer» og ikke de
        samme fire. Udsolgte produkter kommer kun med, hvis der ikke er nok
        andre.
      endcomment
      assign source = section.settings.related_collection
      if source == blank
        assign source = collections['produkter']
      endif
      assign limit = section.settings.related_count

      assign current_index = 0
      for p in source.products limit: 50
        if p.id == product.id
          assign current_index = forloop.index
          break
        endif
      endfor

      assign picked = ''
      assign picked_count = 0
      for round in (1..2)
        for step in (1..50)
          if picked_count >= limit
            break
          endif
          assign total = source.products.size | at_most: 50
          if total == 0
            break
          endif
          if step > total
            break
          endif
          assign i = current_index | plus: step | minus: 1 | modulo: total
          assign p = source.products[i]
          if p.id == product.id
            continue
          endif
          assign marker = '|' | append: p.handle | append: '|'
          if picked contains marker
            continue
          endif
          if round == 1 and p.available == false
            continue
          endif
          assign picked = picked | append: marker
          assign picked_count = picked_count | plus: 1
        endfor
      endfor
    -%}
    {%- if picked_count > 0 -%}
      {%- comment -%} Samme overskrift og kort som «Shop» på forsiden {%- endcomment -%}
      <div class="lalatoto-featured lalatoto-more__related">
        <header class="lalatoto-featured__head">
          <div>
            <h2 class="lalatoto-featured__title">{{ related_heading | escape }}</h2>
          </div>
        </header>
        <ul class="lalatoto-tiles lalatoto-featured__row unstyled-list" role="list">
          {%- assign handles = picked | split: '|' -%}
          {%- for h in handles -%}
            {%- if h == blank -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign p = all_products[h]
              assign hover = nil
              if p.media.size > 1
                assign hover = p.media[1]
                if hover.media_type != 'image'
                  assign hover = nil
                endif
              endif
              assign sold_out = true
              if p.available
                assign sold_out = false
              endif
            -%}
            {%- render 'lalatoto-tile',
              product: p,
              variant: p.selected_or_first_available_variant,
              sold_out: sold_out,
              hover_media: hover,
              show_price: true
            -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Mere om produktet",
  "class": "shopify-section--lalatoto-more",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farveskema",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Boks om materialerne"
    },
    {
      "type": "checkbox",
      "id": "show_story",
      "label": "Vis boksen",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Billede",
      "info": "Tomt: produktets tredje billede."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Lille etiket",
      "info": "Vises kun, når den er udfyldt."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Overskrift",
      "info": "Tom: «Ren uld og bomuld. Ingen polyester.»"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Tekst"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Linktekst",
      "info": "Tom: «Læs om materialerne»."
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link",
      "info": "Tomt: materialesiden."
    },
    {
      "type": "header",
      "content": "Andre kiggede også på"
    },
    {
      "type": "checkbox",
      "id": "show_related",
      "label": "Vis produkter",
      "default": true
    },
    {
      "type": "text",
      "id": "related_heading",
      "label": "Overskrift",
      "info": "Tom: «Andre kiggede også på»."
    },
    {
      "type": "collection",
      "id": "related_collection",
      "label": "Kollektion",
      "info": "Tom: kollektionen «produkter»."
    },
    {
      "type": "range",
      "id": "related_count",
      "label": "Antal produkter",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "paragraph",
      "content": "Produkterne vælges selv fra kollektionen: det viste produkt springes over, og der vises de produkter, der står efter det i kollektionen. Udsolgte kommer sidst."
    }
  ],
  "presets": [
    {
      "name": "Mere om produktet"
    }
  ]
}
{% endschema %}
