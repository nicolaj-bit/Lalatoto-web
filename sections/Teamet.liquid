<style>
  #shopify-section-{{ section.id }} {
    --team-gap: clamp({{ section.settings.card_gap_mobile }}px, calc({{ section.settings.card_gap_mobile }}px + ({{ section.settings.card_gap_desktop }} - {{ section.settings.card_gap_mobile }}) * ((100vw - 375px) / (1400 - 375))), {{ section.settings.card_gap_desktop }}px);
    --team-heading-size: clamp({{ section.settings.heading_size_mobile }}px, calc({{ section.settings.heading_size_mobile }}px + ({{ section.settings.heading_size_desktop }} - {{ section.settings.heading_size_mobile }}) * ((100vw - 375px) / (1400 - 375))), {{ section.settings.heading_size_desktop }}px);
  }

  .team_photo_main { width: 100%; position: relative; display: flex; justify-content: center; }
  .team_photo_in { width: 100%; max-width: var(--page-width, 1200px); padding: 0 20px; }

  .team_photo_in h2 {
    width: 100%;
    text-align: center;
    font-size: var(--team-heading-size);
    font-weight: {% if section.settings.heading_bold %}700{% else %}400{% endif %};
    color: {{ section.settings.heading_color }};
    letter-spacing: 1px;
    margin: 0 0 40px;
    text-transform: uppercase;
  }

  .team_photo_con { width: 100%; display: flex; justify-content: center; flex-wrap: wrap; gap: var(--team-gap); }
  .team_photo { width: calc(25% - var(--team-gap)); display: flex; flex-direction: column; align-items: center; }
  .team_photo_div { width: 100%; position: relative; }

  .timga, .timgb { width: 100%; height: auto; object-fit: cover; border-radius: 10px; display: block; }
  .timgb { opacity: 0; position: absolute; inset: 0; }
  .timga { opacity: 1; }

  @media (hover: hover) and (pointer: fine) {
    .team_photo_div:hover .timga { opacity: 0; }
    .team_photo_div:hover .timgb { opacity: 1; }
  }
  @media (hover: none) { .timgb { display: none; } }

  .team_txt_txt { width: 100%; margin-top: 10px; overflow: hidden; }
  .align-left { text-align: left; } .align-center { text-align: center; } .align-right { text-align: right; }

  .team_txt_txt ul { list-style: disc; list-style-position: inside; padding-left: 0; margin: 0; }
  .team_txt_txt li { margin: 0 0 8px; }

  .tname { font-size: 18px; font-weight: 600; margin: 5px 0; }

  .tposition { font-size: 14px; margin: 0; }
  .tposition p { margin: 0; }
  .tposition a { text-decoration: underline; text-underline-offset: 2px; font-weight: 500; transition: opacity 0.2s ease; }
  .tposition a:hover { opacity: 0.75; }

  .tcontent { margin-top: 10px; font-size: 14px; color: #1c1c1c; }
  .tcontent p { margin: 0 0 10px; }

  @media screen and (max-width: 1024px) { .team_photo { width: calc(33.33% - var(--team-gap)); } }
  @media screen and (max-width: 800px) {
    .team_photo { width: calc(50% - var(--team-gap)); }
    .team_photo_in h2 { margin-bottom: 20px; }
  }
</style>

{%- assign scheme = section.settings.background -%}
{%- assign scheme_bg = scheme.settings.background -%}
{%- assign scheme_text = scheme.settings.text -%}
{%- assign color_scheme_hash = scheme_bg | md5 -%}

<div
  class="section-spacing color-scheme color-scheme--bg-{{ color_scheme_hash }} section-spacing--padded"
  style="{% render 'surface', background: scheme_bg, text_color: scheme_text %}"
>
  <div class="team_photo_main">
    <div class="team_photo_in">
      {% if section.settings.teamheading != blank %}
        <h2>{{ section.settings.teamheading | escape }}</h2>
      {% endif %}

      <div class="team_photo_con">
        {%- for block in section.blocks -%}
          <div class="team_photo" {{ block.shopify_attributes }}>
            <div class="team_photo_div">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    widths: '300, 400, 500, 600, 750, 900',
                    sizes: '(min-width: 990px) 260px, (min-width: 750px) 45vw, 90vw',
                    class: 'timga',
                    loading: 'lazy',
                    alt: block.settings.name | escape
                }}
              {% endif %}

              {% if block.settings.image_a != blank %}
                {{
                  block.settings.image_a
                  | image_url: width: 900
                  | image_tag:
                    widths: '300, 400, 500, 600, 750, 900',
                    sizes: '(min-width: 990px) 260px, (min-width: 750px) 45vw, 90vw',
                    class: 'timgb',
                    loading: 'lazy',
                    alt: block.settings.name | escape
                }}
              {% endif %}
            </div>

            <div class="team_txt_txt">
              {% if block.settings.name != blank %}
                <p class="tname align-{{ block.settings.name_alignment }}">{{ block.settings.name | escape }}</p>
              {% endif %}

              {% if block.settings.position != blank %}
                <div class="tposition align-{{ block.settings.position_alignment }}">
                  {{ block.settings.position }}
                </div>
              {% endif %}

              {% if block.settings.content != blank %}
                <div class="tcontent align-{{ block.settings.content_alignment }}">
                  {{ block.settings.content }}
                </div>
              {% endif %}
            </div>
          </div>
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Team Photos",
  "settings": [
    { "type": "text", "id": "teamheading", "label": "Heading" },

    { "type": "header", "content": "Heading style" },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 18, "max": 60, "step": 1, "default": 30 },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size (desktop)", "min": 24, "max": 90, "step": 1, "default": 60 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#8c481a" },
    { "type": "checkbox", "id": "heading_bold", "label": "Bold heading", "default": true },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "card_gap_mobile", "label": "Card gap (mobile)", "min": 4, "max": 40, "step": 1, "default": 10 },
    { "type": "range", "id": "card_gap_desktop", "label": "Card gap (desktop)", "min": 8, "max": 60, "step": 1, "default": 20 },

    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "background", "label": "Color scheme", "default": "background-1" }
  ],
  "blocks": [
    {
      "type": "images",
      "name": "Team Member",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Team Member Image" },
        { "type": "image_picker", "id": "image_a", "label": "Second Team Member Image (hover)" },

        { "type": "text", "id": "name", "label": "Member name", "default": "Sara" },
        {
          "type": "select",
          "id": "name_alignment",
          "label": "Name alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },

        {
          "type": "richtext",
          "id": "position",
          "label": "Member Position (linkable)",
          "default": "<p>CEO &amp; Co-Founder</p>"
        },
        {
          "type": "select",
          "id": "position_alignment",
          "label": "Position alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },

        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>This is a detailed description or bio of the team member.</p>"
        },
        {
          "type": "select",
          "id": "content_alignment",
          "label": "Content Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        }
      ]
    }
  ],
  "presets": [
    { "category": "custom", "name": "Team Photos" }
  ]
}
{% endschema %}