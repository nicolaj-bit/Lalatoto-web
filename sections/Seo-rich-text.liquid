<!-- seo-rich-text.liquid -->
{% schema %}
{
  "name": "SEO Rich Text",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your SEO Heading Here"
    },
    {
      "type": "richtext",
      "id": "rich_text",
      "label": "Text",
      "default": "<p>Your SEO rich text content here. Add as much content as needed for SEO purposes. This text will be hidden until the button is clicked.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Read More"
    },
    {
      "type": "text",
      "id": "button_text_less",
      "label": "Button Text (Less)",
      "default": "Read Less"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading Font",
      "default": "'Univers Next', sans-serif",
      "options": [
        { "label": "Arial", "value": "Arial, sans-serif" },
        { "label": "Georgia", "value": "Georgia, serif" },
        { "label": "Helvetica", "value": "Helvetica, Arial, sans-serif" },
        { "label": "Times New Roman", "value": "'Times New Roman', Times, serif" },
        { "label": "Courier New", "value": "'Courier New', Courier, monospace" },
        { "label": "Univers Next", "value": "'Univers Next', sans-serif" }
      ]
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading Font Weight",
      "default": "normal",
      "options": [
        { "label": "Normal", "value": "normal" },
        { "label": "Bold", "value": "bold" }
      ]
    },
    {
      "type": "select",
      "id": "text_font",
      "label": "Text Font",
      "default": "Arial, sans-serif",
      "options": [
        { "label": "Arial", "value": "Arial, sans-serif" },
        { "label": "Georgia", "value": "Georgia, serif" },
        { "label": "Helvetica", "value": "Helvetica, Arial, sans-serif" },
        { "label": "Times New Roman", "value": "'Times New Roman', Times, serif" },
        { "label": "Courier New", "value": "'Courier New', Courier, monospace" },
        { "label": "Univers Next", "value": "'Univers Next', sans-serif" }
      ]
    },
    {
      "type": "select",
      "id": "richtext_heading_font_weight",
      "label": "Rich Text Heading Font Weight",
      "default": "normal",
      "options": [
        { "label": "Normal", "value": "normal" },
        { "label": "Bold", "value": "bold" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SEO Rich Text",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<div class="seo-text-container" style="--heading-font: {{ section.settings.heading_font }}; --heading-font-weight: {{ section.settings.heading_font_weight }}; --richtext-heading-font-weight: {{ section.settings.richtext_heading_font_weight }}; --text-font: {{ section.settings.text_font }};">
  <!-- Heading -->
  <h1 class="seo-heading" style="font-family: var(--heading-font); font-weight: var(--heading-font-weight); text-transform: uppercase;">
    {{ section.settings.heading }}
  </h1>

  <!-- SEO rich text -->
  <div class="collapsible-content" id="seoContent-{{ section.id }}" style="font-family: var(--text-font);">
    <div class="content-preview">{{ section.settings.rich_text | raw }}</div>
    <div class="full-content">{{ section.settings.rich_text | raw }}</div>
  </div>

  <!-- Collapsible button -->
  <button class="collapsible-button" id="toggleButton-{{ section.id }}" data-text-more="{{ section.settings.button_text }}" data-text-less="{{ section.settings.button_text_less }}" onclick="toggleSEOContent('{{ section.id }}')">
    {{ section.settings.button_text }}
  </button>
</div>

<!-- JSON-LD structured data til SEO -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ section.settings.heading | json }},
  "articleBody": {{ section.settings.rich_text | strip_html | strip_newlines | json }},
  "author": {
    "@type": "Organization",
    "name": {{ shop.name | json }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "logo": {
      "@type": "ImageObject",
      "url": "{{ shop.brand.logo | img_url: 'master' | prepend: shop.url }}"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ canonical_url }}"
  },
  "dateModified": "{{ 'now' | date: '%Y-%m-%d' }}"
}
</script>

<script>
  function toggleSEOContent(sectionId) {
    const contentPreview = document.querySelector(`#seoContent-${sectionId} .content-preview`);
    const fullContent = document.querySelector(`#seoContent-${sectionId} .full-content`);
    const button = document.querySelector(`#toggleButton-${sectionId}`);
    const heading = document.querySelector(`#seoContent-${sectionId}`).previousElementSibling;

    if (fullContent.style.display === 'block') {
      fullContent.style.display = 'none';
      contentPreview.style.display = 'block';
      button.textContent = button.getAttribute('data-text-more');
      heading.scrollIntoView({ behavior: 'smooth' });
    } else {
      fullContent.style.display = 'block';
      contentPreview.style.display = 'none';
      button.textContent = button.getAttribute('data-text-less');
    }
  }

  document.addEventListener("DOMContentLoaded", function() {
    document.querySelectorAll('.collapsible-button').forEach(button => {
      button.setAttribute('data-text-more', button.textContent);
      button.setAttribute('data-text-less', "{{ section.settings.button_text_less }}");
    });
  });
</script>

<style>
  @font-face {
    font-family: 'Univers Next';
    src: url('path/to/univers-next.woff2') format('woff2'), url('path/to/univers-next.woff') format('woff');
    font-weight: normal;
    font-style: normal;
  }

  .seo-text-container {
    text-align: center;
    margin: 20px 0;
    position: relative;
  }

  .seo-text-container h1.seo-heading {
    font-size: 24px;
    margin-bottom: 10px;
    position: relative;
    font-family: var(--heading-font);
    font-weight: var(--heading-font-weight);
    text-transform: uppercase;
  }

  .seo-text-container h2.seo-heading::after {
    content: "";
    display: block;
    width: 50px;
    height: 2px;
    background-color: #000;
    margin: 10px auto 0;
  }

  .collapsible-content {
    overflow: hidden;
  }

  .content-preview {
    max-height: calc(1.5em * 14);
    overflow: hidden;
    display: block;
  }

  .full-content {
    display: none;
  }

  .collapsible-button {
    position: relative;
    background-color: #E7D3B1;
    color: #fff;
    border: none; /* Fjern den faste kant */
    padding: 10px 20px;
    cursor: pointer;
    margin-top: 10px;
    display: inline-block;
    overflow: hidden; /* For at skjule den animerede kant i starten */
    transition: color 0.8s, background-color 0.3s; /* Glidende overgang på farver */
  }

  .collapsible-button::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    border: 2px solid #E7D3B1;
    transition: left 0.8s; /* Overgang til kant-animationen */
  }

  .collapsible-button:hover::before {
    left: 0; /* Flyt kanten ind i synsfeltet */
  }

  .collapsible-button:hover {
    background-color: transparent;
    color: #E7D3B1;
  }

  /* Understreg links */
  .seo-text-container a {
    text-decoration: underline; /* Tilføj understregning */
    color: inherit; /* Behold samme farve som omkringliggende tekst */
    transition: color 0.3s;
  }

  .seo-text-container a:hover {
    color: #E7D3B1; /* Tilføj farveændring ved hover */
  }

  .seo-text-container {
    text-align: center;
    margin: 20px auto; /* Centerer sektionen og tilføjer vertikal afstand */
    padding: 0 20px; /* Tilføjer luft på siderne */
    max-width: 800px; /* Begrænser den maksimale bredde */
    position: relative;
}
</style>