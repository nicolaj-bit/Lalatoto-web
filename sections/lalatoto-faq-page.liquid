{%- comment -%}
  Lalatoto: FAQ-siden. Samme opbygning som handelsbetingelserne: titlen
  øverst til venstre, «Indhold» i venstre side (følger med og markerer det
  emne, man er nået til) og spørgsmålene til højre.

  På telefon er indholdsfortegnelsen skiftet ud med en bjælke med emnerne,
  der bliver hængende under menuen.

  Spørgsmålene hentes fra Indhold → Metaobjekter → «FAQ (produkter)», de
  samme som under produkterne, så et svar kun skal rettes ét sted:
    1. «Vis på alle produkter» → den generelle gruppe øverst.
    2. Ellers efter den første produkttype i «Vis på disse produkttyper»
       (fx «Sengerand») eller, hvis den er tom, det første valgte produkt.

  Punkterne ser ud og virker som vaskevejledningen (lalatoto-accordion.js):
  én linje pr. spørgsmål, et tyndt plus, og ét åbent svar ad gangen pr.
  emne. Siden får også struktureret data (FAQPage) til søgemaskiner.
{%- endcomment -%}

{%- liquid
  assign general_title = section.settings.general_title
  if general_title == blank
    assign general_title = 'lalatoto.faq.general' | t
  endif

  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'lalatoto.faq.heading' | t
  endif

  assign lead = section.settings.lead
  if lead == blank
    assign lead = 'lalatoto.faq.lead' | t
  endif

  comment
    Gruppernes navne i rækkefølge, omgivet af §, fx «§Bestilling…§Sengerand§».
    Den generelle gruppe står altid først, hvis der er generelle spørgsmål.
  endcomment
  assign has_general = false
  assign names = '§'
  for entry in shop.metaobjects.lalatoto_faq.values
    if entry.sporgsmal.value == blank
      continue
    endif
    if entry.alle_produkter.value == true
      assign has_general = true
      continue
    endif
    assign group = entry.produkttyper.value.first | strip
    if group == blank
      assign group = entry.produkter.value.first.title | strip
    endif
    if group == blank
      continue
    endif
    assign group_marker = '§' | append: group | append: '§'
    unless names contains group_marker
      assign names = names | append: group | append: '§'
    endunless
  endfor
  if has_general
    assign names = names | prepend: general_title | prepend: '§'
  endif
  assign group_names = names | split: '§' | compact
  assign group_count = 0
  for name in group_names
    if name != blank
      assign group_count = group_count | plus: 1
    endif
  endfor
-%}

<div id="lalatoto-faq-{{ section.id }}" class="lalatoto-legal lalatoto-faqpage color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <div class="lalatoto-legal__inner">
    <header class="lalatoto-legal__head">
      <h1 class="lalatoto-legal__title">{{ heading | escape }}</h1>
      {%- if lead != blank -%}
        <p class="lalatoto-faqpage__lead">{{ lead | escape }}</p>
      {%- endif -%}
    </header>

    {%- if group_count > 1 -%}
      <nav class="lalatoto-legal__toc" aria-label="{{ 'lalatoto.legal.toc_title' | t | escape }}">
        <p class="lalatoto-legal__toc-title">{{ 'lalatoto.legal.toc_title' | t }}</p>
        <ol>
          {%- for name in group_names -%}
            {%- if name != blank -%}
              <li><a href="#faq-{{ name | handleize }}" data-faq-link>{{ name | escape }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      </nav>
    {%- endif -%}

    <div class="lalatoto-legal__body lalatoto-faqpage__body">
      <div class="lalatoto-faqpage__tools">
        {%- if group_count > 1 -%}
          <nav class="lalatoto-faqpage__chips" aria-label="{{ 'lalatoto.faq.topics' | t | escape }}">
            {%- for name in group_names -%}
              {%- if name != blank -%}
                <a href="#faq-{{ name | handleize }}" data-faq-link>{{ name | escape }}</a>
              {%- endif -%}
            {%- endfor -%}
          </nav>
        {%- endif -%}
      </div>

      {%- for name in group_names -%}
        {%- if name == blank -%}{%- continue -%}{%- endif -%}
        {%- assign is_general_group = false -%}
        {%- if has_general and name == general_title -%}{%- assign is_general_group = true -%}{%- endif -%}

        <section class="lalatoto-faqpage__group" id="faq-{{ name | handleize }}" data-faq-group>
          <h2>{{ name | escape }}</h2>
          <div class="lalatoto-wash__list" data-lalatoto-accordion>
            {%- for entry in shop.metaobjects.lalatoto_faq.values -%}
              {%- liquid
                if entry.sporgsmal.value == blank
                  continue
                endif
                assign belongs = false
                if is_general_group
                  if entry.alle_produkter.value == true
                    assign belongs = true
                  endif
                elsif entry.alle_produkter.value != true
                  assign entry_group = entry.produkttyper.value.first | strip
                  if entry_group == blank
                    assign entry_group = entry.produkter.value.first.title | strip
                  endif
                  if entry_group == name
                    assign belongs = true
                  endif
                endif
                unless belongs
                  continue
                endunless
              -%}
              <details class="lalatoto-wash__item" data-faq-item>
                <summary class="lalatoto-wash__summary">
                  <span class="lalatoto-wash__name">{{ entry.sporgsmal.value | escape }}</span>
                  <span class="lalatoto-wash__sign" aria-hidden="true"></span>
                </summary>
                <div class="lalatoto-wash__body">
                  <div class="lalatoto-wash__text">{{ entry.svar | metafield_tag }}</div>
                </div>
              </details>
            {%- endfor -%}
          </div>
        </section>
      {%- endfor -%}

      <p class="lalatoto-faqpage__foot">{{ 'lalatoto.faq.contact_html' | t }}</p>
    </div>
  </div>
</div>

{%- comment -%} Struktureret data til søgemaskiner {%- endcomment -%}
{%- capture faq_json -%}
  {%- assign first_question = true -%}
  {%- for entry in shop.metaobjects.lalatoto_faq.values -%}
    {%- if entry.sporgsmal.value == blank or entry.svar.value == blank -%}{%- continue -%}{%- endif -%}
    {%- unless first_question -%},{%- endunless -%}
    {%- assign first_question = false -%}
    {"@type": "Question", "name": {{ entry.sporgsmal.value | json }}, "acceptedAnswer": {"@type": "Answer", "text": {{ entry.svar | metafield_text | json }}}}
  {%- endfor -%}
{%- endcapture -%}
{%- if faq_json != blank -%}
  <script type="application/ld+json">
    {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{{ faq_json }}]}
  </script>
{%- endif -%}

<script src="{{ 'lalatoto-accordion.js' | asset_url }}" defer></script>
<script>
  (function () {
    var root = document.getElementById('lalatoto-faq-{{ section.id }}');
    if (!root || root.dataset.faqReady === '1') return;
    root.dataset.faqReady = '1';

    var groups = Array.prototype.slice.call(root.querySelectorAll('[data-faq-group]'));
    var links = Array.prototype.slice.call(root.querySelectorAll('[data-faq-link]'));
    var chips = root.querySelector('.lalatoto-faqpage__chips');
    var tools = root.querySelector('.lalatoto-faqpage__tools');
    var smooth = !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);

    function stickyOffset() {
      var header = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--sticky-area-height')) || 64;
      var bar = tools && getComputedStyle(tools).position === 'sticky' ? tools.offsetHeight : 0;
      return header + bar + 16;
    }

    /* Klik på et emne: rul blødt ned, så overskriften ikke gemmer sig under menuen og bjælken. */
    links.forEach(function (link) {
      link.addEventListener('click', function (event) {
        var target = document.getElementById(link.getAttribute('href').slice(1));
        if (!target) return;
        event.preventDefault();
        var top = target.getBoundingClientRect().top + window.pageYOffset - stickyOffset() + 8;
        window.scrollTo({ top: top, behavior: smooth ? 'smooth' : 'auto' });
        if (history.replaceState) history.replaceState(null, '', link.getAttribute('href'));
      });
    });

    /* Markér det emne, man er nået til, både i indholdsfortegnelsen og i bjælken. */
    var waiting = false;
    function mark() {
      waiting = false;
      var limit = stickyOffset() + 24;
      var active = null;
      groups.forEach(function (group) {
        if (!group.hidden && group.getBoundingClientRect().top <= limit) active = group;
      });
      if (!active) active = groups.filter(function (g) { return !g.hidden; })[0];
      var id = active ? active.id : '';
      links.forEach(function (link) {
        var on = link.getAttribute('href') === '#' + id;
        if (on) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
        if (on && chips && link.parentElement === chips) {
          var left = link.offsetLeft - (chips.clientWidth - link.offsetWidth) / 2;
          if (Math.abs(chips.scrollLeft - left) > 4) chips.scrollTo({ left: left, behavior: smooth ? 'smooth' : 'auto' });
        }
      });
    }
    window.addEventListener('scroll', function () {
      if (waiting) return;
      waiting = true;
      requestAnimationFrame(mark);
    }, { passive: true });
    mark();

  })();
</script>

{% schema %}
{
  "name": "Lalatoto FAQ-side",
  "class": "shopify-section--lalatoto-faq-page",
  "tag": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Spørgsmålene hentes fra Indhold → Metaobjekter → «FAQ (produkter)». Spørgsmål med «Vis på alle produkter» står i den første gruppe; de andre grupperes efter produkttype."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farveskema",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "info": "Tom: «Spørgsmål og svar»."
    },
    {
      "type": "text",
      "id": "lead",
      "label": "Kort tekst under overskriften",
      "info": "Tom: standardteksten."
    },
    {
      "type": "text",
      "id": "general_title",
      "label": "Navn på den generelle gruppe",
      "info": "Tom: «Bestilling, levering og retur»."
    }
  ],
  "presets": [
    {
      "name": "Lalatoto FAQ-side"
    }
  ]
}
{% endschema %}
