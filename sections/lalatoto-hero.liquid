{%- comment -%}
  Lalatoto: forsidens hero. Tekst til venstre og billede til højre på computer,
  billede øverst og tekst under på telefon. Headeren er gennemsigtig over sektionen,
  når den ligger øverst på siden.
{%- endcomment -%}

{%- liquid
  comment
    Alt-tekst til Google og skærmlæsere: feltet i sektionen, ellers billedets
    egen alt-tekst, ellers overskriften.
  endcomment
  assign image_alt = section.settings.image_alt | default: section.settings.image.alt
  if image_alt == blank
    assign image_alt = section.settings.heading_line_1 | append: ' ' | append: section.settings.heading_line_2 | strip_html | strip
  endif
-%}

<div
  class="lalatoto-hero color-scheme color-scheme--{{ section.settings.color_scheme.id }}"
  {% if section.settings.allow_transparent_header %}
    allow-transparent-header
  {% endif %}
>
  <div class="lalatoto-hero__inner">
    <div class="lalatoto-hero__media">
      {%- if section.settings.image != blank -%}
        <picture>
          {%- if section.settings.mobile_image != blank -%}
            <source
              media="(max-width: 699px)"
              srcset="{{ section.settings.mobile_image | image_url: width: 600 }} 600w, {{ section.settings.mobile_image | image_url: width: 900 }} 900w, {{ section.settings.mobile_image | image_url: width: 1200 }} 1200w"
              width="{{ section.settings.mobile_image.width }}"
              height="{{ section.settings.mobile_image.height }}"
            >
          {%- endif -%}

          {{-
            section.settings.image
            | image_url: width: section.settings.image.width
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              sizes: '(max-width: 699px) 100vw, 50vw',
              widths: '400,600,800,1000,1200,1400,1600,1800,2000',
              class: 'lalatoto-hero__image',
          alt: image_alt
          -}}
        </picture>
      {%- else -%}
        {{- 'lifestyle-2' | placeholder_svg_tag: 'lalatoto-hero__image placeholder' -}}
      {%- endif -%}
    </div>

    <div class="lalatoto-hero__content">
      {%- if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank -%}
        <h1 class="h1 lalatoto-hero__heading">
          {%- if section.settings.heading_line_1 != blank -%}
            <span class="lalatoto-hero__line">{{ section.settings.heading_line_1 }}</span>
          {%- endif -%}
          {%- if section.settings.heading_line_2 != blank -%}
            <span class="lalatoto-hero__line">{{ section.settings.heading_line_2 }}</span>
          {%- endif -%}
        </h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="prose lalatoto-hero__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_text != blank -%}
        <a href="{{ section.settings.button_url | default: routes.all_products_collection_url }}" class="lalatoto-button-outline">
          {{- section.settings.button_text | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Lalatoto hero",
  "class": "shopify-section--lalatoto-hero",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farveskema",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "allow_transparent_header",
      "label": "Gennemsigtig header over sektionen",
      "info": "Virker kun, når sektionen ligger øverst på siden.",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Billede",
      "info": "Anbefalet: 1600 × 2000 px (4:5, stående). Vises i halv bredde på computer og fuld bredde på telefon. Er det sidens første billede, tæller det mest for PageSpeed. Brug JPG (ikke PNG), sRGB, under ca. 400 KB. Shopify laver selv mindre udgaver og WebP; større end anbefalet gør kun siden langsommere."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Billedtekst til Google (alt-tekst)",
      "info": "Beskriv kort, hvad billedet viser, fx «Baby sover under uld dyne i tremmeseng». Hjælper Google Billeder og skærmlæsere."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Billede på telefon",
      "info": "Valgfrit. Bruges i stedet for billedet ovenfor på telefon. Anbefalet: 1200 × 1500 px (4:5). Brug JPG (ikke PNG), sRGB, under ca. 250 KB. Shopify laver selv mindre udgaver og WebP; større end anbefalet gør kun siden langsommere."
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Overskrift, linje 1",
      "default": "Første linje"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Overskrift, linje 2",
      "default": "anden linje"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "default": "<p>En kort tekst om Lalatoto.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Knaptekst",
      "default": "Shop"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Knaplink"
    }
  ],
  "presets": [
    {
      "name": "Lalatoto hero"
    }
  ]
}
{% endschema %}
