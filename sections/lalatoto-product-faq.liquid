{%- comment -%}
  Lalatoto: spørgsmål og svar under produktet.

  Spørgsmålene oprettes i Shopify under Indhold → Metaobjekter → «FAQ
  (produkter)». Hvert spørgsmål vises, når mindst én af disse passer:
    1. produktet er valgt under «Vis på disse produkter»,
    2. produktets type står under «Vis på disse produkttyper»
       (fx «Luksus sengeslange», uden forskel på store og små bogstaver),
    3. «Vis på alle produkter» er slået til (levering, returnering osv.).
  Spørgsmål, der handler om produktet, står først, de generelle sidst.
  Finder sektionen ingen spørgsmål, vises den slet ikke.

  Spørgsmålene står i to faner: produktets egne og de generelle (levering
  og retur). Første spørgsmål er åbent, og kun ét svar er åbent ad gangen.
  Uden JavaScript vises begge lister under hinanden.
{%- endcomment -%}

{%- liquid
  assign product_type = product.type | downcase | strip
  assign specific = ''
  assign general = ''
  assign count = 0

  for entry in shop.metaobjects.lalatoto_faq.values
    assign question = entry.sporgsmal.value
    if question == blank
      continue
    endif

    assign matches = false
    for referenced in entry.produkter.value
      if referenced.id == product.id
        assign matches = true
        break
      endif
    endfor

    unless matches
      for entry_type in entry.produkttyper.value
        assign entry_type_down = entry_type | downcase | strip
        if entry_type_down == product_type and product_type != blank
          assign matches = true
          break
        endif
      endfor
    endunless

    assign is_general = false
    if matches == false and entry.alle_produkter.value == true and section.settings.show_general
      assign is_general = true
    endif

    if matches or is_general
      assign count = count | plus: 1
      capture item
        echo '<details class="lalatoto-wash__item" name="lalatoto-faq-' | append: section.id | append: '">'
        assign question_html = question | escape
        echo '<summary class="lalatoto-wash__summary"><span class="lalatoto-wash__name">' | append: question_html | append: '</span><span class="lalatoto-wash__sign" aria-hidden="true"></span></summary>'
        echo '<div class="lalatoto-wash__body"><div class="lalatoto-wash__text">'
        echo entry.svar | metafield_tag
        echo '</div></div></details>'
      endcapture
      if matches
        assign specific = specific | append: item
      else
        assign general = general | append: item
      endif
    endif
  endfor

  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'lalatoto.faq.heading' | t
  endif
-%}

{%- if count > 0 -%}
  {%- liquid
    assign has_tabs = false
    if specific != blank and general != blank
      assign has_tabs = true
    endif
    assign tab_id = 'lalatoto-faq-' | append: section.id
    if specific != blank
      assign specific = specific | replace_first: '<details class="lalatoto-wash__item"', '<details open class="lalatoto-wash__item"'
    else
      assign general = general | replace_first: '<details class="lalatoto-wash__item"', '<details open class="lalatoto-wash__item"'
    endif
  -%}
  <div class="lalatoto-faq color-scheme color-scheme--{{ section.settings.color_scheme.id }}" id="{{ tab_id }}-root">
    <div class="lalatoto-faq__inner">
      <header class="lalatoto-faq__head">
        <p class="lalatoto-kicker">{{ 'lalatoto.faq.kicker' | t }}</p>
        <h2 class="lalatoto-faq__title">{{ heading | escape }}</h2>
      </header>

      {%- if has_tabs -%}
        <div class="lalatoto-faq__tabs" role="tablist" hidden>
          <button type="button" class="lalatoto-faq__tab" role="tab" id="{{ tab_id }}-t1" aria-controls="{{ tab_id }}-p1" aria-selected="true">{{ product.title | escape }}</button>
          <button type="button" class="lalatoto-faq__tab" role="tab" id="{{ tab_id }}-t2" aria-controls="{{ tab_id }}-p2" aria-selected="false" tabindex="-1">{{ 'lalatoto.faq.general_short' | t }}</button>
        </div>
      {%- endif -%}

      {%- if specific != blank -%}
        <div class="lalatoto-wash__list" id="{{ tab_id }}-p1" {% if has_tabs %}role="tabpanel" aria-labelledby="{{ tab_id }}-t1"{% endif %} data-lalatoto-accordion>
          {{- specific -}}
        </div>
      {%- endif -%}
      {%- if general != blank -%}
        <div class="lalatoto-wash__list" id="{{ tab_id }}-p2" {% if has_tabs %}role="tabpanel" aria-labelledby="{{ tab_id }}-t2"{% endif %} data-lalatoto-accordion>
          {{- general -}}
        </div>
      {%- endif -%}

      <p class="lalatoto-wash__foot">{{ 'lalatoto.faq.contact_html' | t }}</p>
    </div>
  </div>

  <script src="{{ 'lalatoto-accordion.js' | asset_url }}" defer></script>
  {%- if has_tabs -%}
    <script>
      /* Fanerne: viser én liste ad gangen. Uden JavaScript står begge lister fremme. */
      (function () {
        var root = document.getElementById('{{ tab_id }}-root');
        var bar = root.querySelector('.lalatoto-faq__tabs');
        if (!bar) return;
        var tabs = Array.prototype.slice.call(bar.querySelectorAll('[role="tab"]'));
        function select(tab, focus) {
          tabs.forEach(function (t) {
            var on = t === tab;
            t.setAttribute('aria-selected', on ? 'true' : 'false');
            t.tabIndex = on ? 0 : -1;
            document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
          });
          if (focus) tab.focus();
        }
        tabs.forEach(function (tab, i) {
          tab.addEventListener('click', function () { select(tab, false); });
          tab.addEventListener('keydown', function (e) {
            if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
            e.preventDefault();
            select(tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length], true);
          });
        });
        bar.hidden = false;
        select(tabs[0], false);
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Lalatoto FAQ",
  "class": "shopify-section--lalatoto-faq",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farveskema",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "info": "Tom: «Spørgsmål og svar»."
    },
    {
      "type": "checkbox",
      "id": "show_general",
      "label": "Vis også generelle spørgsmål",
      "info": "Spørgsmål med «Vis på alle produkter», fx om levering og returnering. De står efter spørgsmålene om produktet.",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Spørgsmål og svar rettes i Shopify under Indhold → Metaobjekter → FAQ (produkter). Vælg på hvert spørgsmål, hvilke produkter eller produkttyper det gælder."
    }
  ],
  "presets": [
    {
      "name": "Lalatoto FAQ"
    }
  ]
}
{% endschema %}
