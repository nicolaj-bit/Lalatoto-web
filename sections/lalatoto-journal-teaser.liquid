{%- comment -%}
  Lalatoto: «Fra journalen» på forsiden. De nyeste artikler fra den valgte
  blog i tre kolonner (én på telefon) med et link til hele journalen.
{%- endcomment -%}

{%- liquid
  assign journal = section.settings.blog
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'lalatoto.journal.teaser_heading' | t
  endif
-%}

{%- if journal != blank and journal.articles_count > 0 -%}
  <div class="lalatoto-journal-teaser color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
    <header class="lalatoto-journal-teaser__head">
      <div>
        <p class="lalatoto-kicker">{{ 'lalatoto.journal.kicker' | t }}</p>
        <h2 class="lalatoto-journal-teaser__title">{{ heading | escape }}</h2>
      </div>
      <a href="{{ journal.url }}" class="lalatoto-journal-teaser__all">
        {{- 'lalatoto.journal.all_articles' | t -}} <span aria-hidden="true">→</span>
      </a>
    </header>

    <div class="lalatoto-journal-teaser__grid">
      {%- for article in journal.articles limit: section.settings.count -%}
        {%- render 'lalatoto-article-card', article: article, show_excerpt: section.settings.show_excerpt -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Lalatoto fra journalen",
  "class": "shopify-section--lalatoto-journal-teaser",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farveskema",
      "default": "scheme-1"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "info": "Tom: «Fra journalen»."
    },
    {
      "type": "range",
      "id": "count",
      "label": "Antal artikler",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Vis kort tekst",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Lalatoto fra journalen"
    }
  ]
}
{% endschema %}
