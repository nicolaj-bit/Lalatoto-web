{%- comment -%}
  Lalatoto: vaskevejledning. Centreret overskrift og kort linje, derunder en
  liste med ét punkt pr. produkt (navn, vasketemperatur og tekst), der
  folder sig ud, når man trykker. Nederst en linje med kontaktinfo.

  Hvert punkt er en blok. Blokkens felter kan udfyldes i temaeditoren. Er et
  felt tomt, bruges standardteksten fra sprogfilerne for det valgte produkt,
  så standardpunkterne findes på dansk, engelsk og tysk.

  Listen bygger på <details>, så den kan åbnes og lukkes med tastaturet
  (Tab og Enter/mellemrum). Scriptet nederst lægger kun den bløde
  fold-animation ovenpå.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'lalatoto.wash.heading' | t
  endif
  assign lead = section.settings.lead
  if lead == blank
    assign lead = 'lalatoto.wash.lead' | t
  endif
  assign contact = section.settings.contact
  if contact == blank
    assign contact = 'lalatoto.wash.contact_html' | t
  endif
-%}

<div class="lalatoto-wash color-scheme color-scheme--{{ section.settings.color_scheme.id }}" id="lalatoto-wash-{{ section.id }}">
  <header class="lalatoto-wash__head">
    <h1 class="lalatoto-wash__title">{{ heading | escape }}</h1>
    <p class="lalatoto-lead">{{ lead | escape }}</p>
  </header>

  {%- if section.blocks.size > 0 -%}
    <div class="lalatoto-wash__list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign key = block.settings.standard
          assign name = block.settings.name
          assign temperature = block.settings.temperature
          assign text = block.settings.text

          if key != 'none'
            if name == blank
              assign name_key = 'lalatoto.wash.items.' | append: key | append: '.name'
              assign name = name_key | t
            endif
            if temperature == blank
              assign temperature_key = 'lalatoto.wash.items.' | append: key | append: '.temperature'
              assign temperature = temperature_key | t
            endif
            if text == blank
              assign text_key = 'lalatoto.wash.items.' | append: key | append: '.text'
              assign text = text_key | t
              assign text = '<p>' | append: text | append: '</p>'
            endif
          endif
        -%}

        {%- if name != blank -%}
          <details class="lalatoto-wash__item" name="lalatoto-wash-{{ section.id }}" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="lalatoto-wash__summary">
              <span class="lalatoto-wash__name">{{ name | escape }}</span>
              {%- if temperature != blank -%}
                <span class="lalatoto-wash__temp">{{ temperature | escape }}</span>
              {%- endif -%}
              <span class="lalatoto-wash__sign" aria-hidden="true"></span>
            </summary>
            <div class="lalatoto-wash__body">
              <div class="lalatoto-wash__text">{{ text }}</div>
            </div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  <p class="lalatoto-wash__foot">{{ contact }}</p>
</div>

<script>
  /*
   * Vaskevejledningen: kun ét punkt er åbent ad gangen. Åbner man et nyt,
   * lukker det åbne. Teksten folder blødt ud og ind (ca. 0,28 sek.). For dem,
   * der har slået bevægelse fra, sker det samme uden animation.
   */
  (function () {
    var root = document.getElementById('lalatoto-wash-{{ section.id }}');
    if (!root || root.dataset.washReady === '1') return;
    root.dataset.washReady = '1';

    var DURATION = 280;
    var reduce = window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)') : null;
    var items = Array.prototype.slice.call(root.querySelectorAll('.lalatoto-wash__item'));

    function body(item) {
      return item.querySelector('.lalatoto-wash__body');
    }

    function currentHeight(item) {
      return item.animation ? body(item).getBoundingClientRect().height : null;
    }

    function close(item) {
      if (!item.open || item.classList.contains('is-closing')) return;
      var from = currentHeight(item);
      if (item.animation) item.animation.cancel();

      if ((reduce && reduce.matches) || !body(item).animate) {
        item.open = false;
        return;
      }

      item.classList.remove('is-opening');
      item.classList.add('is-closing');
      item.animation = body(item).animate(
        [{ height: (from === null ? body(item).offsetHeight : from) + 'px', opacity: 1 }, { height: '0px', opacity: 0 }],
        { duration: DURATION, easing: 'ease' }
      );
      item.animation.onfinish = function () {
        item.classList.remove('is-closing');
        item.animation = null;
        item.open = false;
      };
      item.animation.oncancel = function () {
        item.classList.remove('is-closing');
      };
    }

    function open(item) {
      items.forEach(function (other) {
        if (other !== item) close(other);
      });

      var from = currentHeight(item);
      if (item.animation) item.animation.cancel();
      item.classList.remove('is-closing');

      /* Uden name-attributten lukker browseren ikke selv de andre, når vi
         åbner her; det har close() ovenfor allerede klaret. */
      item.open = true;

      if ((reduce && reduce.matches) || !body(item).animate) return;

      item.classList.add('is-opening');
      var height = body(item).offsetHeight;
      item.animation = body(item).animate(
        [{ height: (from === null ? 0 : from) + 'px', opacity: 0 }, { height: height + 'px', opacity: 1 }],
        { duration: DURATION, easing: 'ease' }
      );
      item.animation.onfinish = item.animation.oncancel = function () {
        item.classList.remove('is-opening');
        item.animation = null;
      };
    }

    items.forEach(function (item) {
      /* name-attributten ville lukke de andre med det samme og uden animation,
         så den fjernes; scriptet står selv for, at kun ét punkt er åbent. */
      item.removeAttribute('name');

      item.querySelector('summary').addEventListener('click', function (event) {
        event.preventDefault();
        var shouldClose = item.open && !item.classList.contains('is-closing');
        if (shouldClose) close(item);
        else open(item);
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Lalatoto vaskevejledning",
  "class": "shopify-section--lalatoto-wash",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farveskema",
      "default": "scheme-1"
    },
    {
      "type": "paragraph",
      "content": "Tomme felter bruger temaets standardtekst, som findes på dansk, engelsk og tysk. Skriver du noget her, vises det i stedet."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift"
    },
    {
      "type": "text",
      "id": "lead",
      "label": "Linje under overskriften"
    },
    {
      "type": "inline_richtext",
      "id": "contact",
      "label": "Kontaktlinje nederst"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Punkt",
      "settings": [
        {
          "type": "select",
          "id": "standard",
          "label": "Standardtekst",
          "info": "Tomme felter herunder udfyldes med standardteksten for det valgte produkt på alle sprog. Vælg «Ingen» for et nyt produkt, og udfyld felterne selv.",
          "options": [
            { "value": "none", "label": "Ingen" },
            { "value": "hvalen", "label": "Hvalen LALA" },
            { "value": "sengerand", "label": "Sengerand" },
            { "value": "sengeslange", "label": "Sengeslange" },
            { "value": "sengetoej", "label": "Sengetøj" },
            { "value": "maanepude", "label": "Månepude" },
            { "value": "sengelomme", "label": "Sengelomme" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Navn"
        },
        {
          "type": "text",
          "id": "temperature",
          "label": "Temperatur",
          "info": "Fx «40°C» eller «40°C skånevask»."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Tekst"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lalatoto vaskevejledning",
      "blocks": [
        { "type": "item", "settings": { "standard": "hvalen" } },
        { "type": "item", "settings": { "standard": "sengerand" } },
        { "type": "item", "settings": { "standard": "sengeslange" } },
        { "type": "item", "settings": { "standard": "sengetoej" } },
        { "type": "item", "settings": { "standard": "maanepude" } },
        { "type": "item", "settings": { "standard": "sengelomme" } }
      ]
    }
  ]
}
{% endschema %}
