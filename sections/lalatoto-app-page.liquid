{%- comment -%}
  Lalatoto: side om Club No Sleep, vores app til gravide og mødre (siden
  /pages/club-no-sleep). Forsidens kortere afsnit om appen er lalatoto-app.
  Tekst og billeder kommer fra clubnosleep.com og kan rettes i temaeditoren.

  Opbygning:
    1. Åbning: lille overskrift, titel, kort tekst, knapper til App Store og
       Google Play, prøveperiode og pris. Til højre et billede fra appen.
    2. Indledning: en kort citatagtig overskrift og tekst.
    3. Blokkene i den rækkefølge, de står:
       - «Afsnit med billede»: overskrift, tekst og billede.
         Billedet skifter side for hvert afsnit på computer.
       - «Funktion»: står de efter hinanden, samles de i et gitter med
         numre (01, 02 …) under overskriften for funktionerne.
    4. Afslutning: overskrift, tekst, hilsen og knapperne igen
       med vilkårene for abonnementet (Apple 3.1.2: prøveperiode og pris
       skal stå tydeligt).
{%- endcomment -%}

{%- capture app_buttons -%}
  {%- render 'lalatoto-store-buttons', app_store_url: section.settings.app_store_url, google_play_url: section.settings.google_play_url -%}
{%- endcapture -%}

<div class="lalatoto-apppage color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <div class="lalatoto-apppage__hero">
    <div class="lalatoto-apppage__hero-text">
      {%- if section.settings.kicker != blank -%}
        <p class="lalatoto-kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      <h1 class="lalatoto-apppage__title">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.lead != blank -%}
        <div class="lalatoto-apppage__lead">{{ section.settings.lead }}</div>
      {%- endif -%}
      {{ app_buttons }}
      {%- if section.settings.trial_note != blank -%}
        <p class="lalatoto-apppage__note">{{ section.settings.trial_note | escape }}</p>
      {%- endif -%}
    </div>
    {%- liquid
      assign hero_images = ''
      if section.settings.hero_image != blank
        assign hero_images = 'hero_image,'
      endif
      if section.settings.hero_image_2 != blank
        assign hero_images = hero_images | append: 'hero_image_2,'
      endif
      assign hero_images = hero_images | split: ','
    -%}
    {%- if hero_images.size > 0 -%}
      {%- comment -%}
        To telefoner på computer. På telefon vises kun én, og hvilken der
        vises, skifter hver mandag (scriptet nederst). Uden script vises den første.
      {%- endcomment -%}
      <div class="lalatoto-apppage__hero-phones" data-hero-phones>
        {%- for key in hero_images -%}
          <div class="lalatoto-app__phone lalatoto-apppage__phone lalatoto-apppage__phone--hero{% if forloop.first %} is-week{% endif %}" data-hero-phone>
            <div class="lalatoto-app__screen">{{- section.settings[key] | image_url: width: 900 | image_tag: loading: 'eager', sizes: '(min-width: 1000px) 260px, 62vw', widths: '400,600,900' -}}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.intro_heading != blank or section.settings.intro_text != blank -%}
    <div class="lalatoto-apppage__intro">
      {%- if section.settings.intro_heading != blank -%}
        <h2 class="lalatoto-apppage__quote">{{ section.settings.intro_heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro_text != blank -%}
        <div class="lalatoto-apppage__text">{{ section.settings.intro_text }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- assign in_features = false -%}
  {%- assign feature_number = 0 -%}
  {%- assign story_number = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'feature' -%}
      {%- unless in_features -%}
        {%- assign in_features = true -%}
        {%- echo '<div class="lalatoto-apppage__features">' -%}
          <div class="lalatoto-apppage__features-head">
            {%- if section.settings.features_heading != blank -%}
              <h2 class="lalatoto-apppage__heading">{{ section.settings.features_heading | escape }}</h2>
            {%- endif -%}
            {%- if section.settings.features_image != blank -%}
              <div class="lalatoto-app__phone lalatoto-apppage__phone">
                <div class="lalatoto-app__screen">{{- section.settings.features_image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 240px, 50vw', widths: '400,700' -}}</div>
              </div>
            {%- endif -%}
          </div>
          {%- echo '<ol class="lalatoto-apppage__feature-list" role="list">' -%}
      {%- endunless -%}
      {%- assign feature_number = feature_number | plus: 1 -%}
      <li class="lalatoto-apppage__feature" {{ block.shopify_attributes }}>
        <p class="lalatoto-apppage__number">{% if feature_number < 10 %}0{% endif %}{{ feature_number }}</p>
        <p class="lalatoto-apppage__label">{{ block.settings.title | escape }}</p>
        <p class="lalatoto-apppage__feature-text">{{ block.settings.text | escape }}</p>
      </li>
      {%- if forloop.last -%}
        {%- echo '</ol></div>' -%}
      {%- endif -%}
    {%- else -%}
      {%- if in_features -%}
        {%- echo '</ol></div>' -%}
        {%- assign in_features = false -%}
      {%- endif -%}
      {%- assign story_number = story_number | plus: 1 -%}
      {%- assign story_flip = story_number | modulo: 2 -%}
      <div class="lalatoto-apppage__story{% if story_flip == 0 %} lalatoto-apppage__story--flip{% endif %}" {{ block.shopify_attributes }}>
        <div class="lalatoto-apppage__story-text">
          {%- if block.settings.heading != blank -%}
            <h2 class="lalatoto-apppage__heading">{{ block.settings.heading | escape }}</h2>
          {%- endif -%}
          <div class="lalatoto-apppage__text">{{ block.settings.text }}</div>
        </div>
        {%- if block.settings.image != blank -%}
          <div class="lalatoto-app__phone lalatoto-apppage__phone">
            <div class="lalatoto-app__screen">{{- block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 260px, 56vw', widths: '400,700' -}}</div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}

  <div class="lalatoto-apppage__closing">
    {%- if section.settings.closing_heading != blank -%}
      <h2 class="lalatoto-apppage__heading">{{ section.settings.closing_heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.closing_text != blank -%}
      <div class="lalatoto-apppage__text">{{ section.settings.closing_text }}</div>
    {%- endif -%}
    {%- if section.settings.signature != blank -%}
      <p class="lalatoto-apppage__signature">{{ section.settings.signature | escape }}</p>
    {%- endif -%}
    {{ app_buttons }}
    {%- if section.settings.trial_note != blank -%}
      <p class="lalatoto-apppage__note">{{ section.settings.trial_note | escape }}</p>
    {%- endif -%}
    {%- if section.settings.terms != blank -%}
      <p class="lalatoto-apppage__terms">{{ section.settings.terms | escape }}</p>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    /* Telefon: vis én af åbningens telefoner, og skift hver mandag. */
    document.querySelectorAll('[data-hero-phones]').forEach(function (box) {
      var phones = box.querySelectorAll('[data-hero-phone]');
      if (phones.length < 2) return;
      var monday = Date.UTC(2024, 0, 1);
      var now = new Date();
      var today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
      var week = Math.floor((today - monday) / 604800000);
      phones.forEach(function (phone, index) {
        phone.classList.toggle('is-week', index === week % phones.length);
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Lalatoto app-side",
  "class": "shopify-section--lalatoto-app-page",
  "tag": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Farveskema", "default": "scheme-1" },
    { "type": "header", "content": "Åbning" },
    { "type": "text", "id": "kicker", "label": "Lille overskrift", "default": "Club No Sleep" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Til dig, der er vågen, når resten af verden sover." },
    { "type": "richtext", "id": "lead", "label": "Tekst" },
    { "type": "image_picker", "id": "hero_image", "label": "Billede fra appen" },
    { "type": "image_picker", "id": "hero_image_2", "label": "Billede fra appen 2", "info": "På computer står de to telefoner side om side. På telefon vises én ad gangen, og den skifter hver uge." },
    { "type": "url", "id": "app_store_url", "label": "Link til App Store" },
    { "type": "url", "id": "google_play_url", "label": "Link til Google Play" },
    { "type": "text", "id": "trial_note", "label": "Prøveperiode og pris", "info": "Vises under knapperne øverst og nederst." },
    { "type": "header", "content": "Indledning" },
    { "type": "text", "id": "intro_heading", "label": "Overskrift" },
    { "type": "richtext", "id": "intro_text", "label": "Tekst" },
    { "type": "header", "content": "Funktioner" },
    { "type": "paragraph", "content": "Funktionerne er blokke af typen «Funktion». De samles under denne overskrift." },
    { "type": "text", "id": "features_heading", "label": "Overskrift" },
    { "type": "image_picker", "id": "features_image", "label": "Billede fra appen" },
    { "type": "header", "content": "Afslutning" },
    { "type": "text", "id": "closing_heading", "label": "Overskrift" },
    { "type": "richtext", "id": "closing_text", "label": "Tekst" },
    { "type": "text", "id": "signature", "label": "Hilsen" },
    { "type": "textarea", "id": "terms", "label": "Vilkår for abonnementet" }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Afsnit med billede",
      "settings": [
        { "type": "text", "id": "heading", "label": "Overskrift" },
        { "type": "richtext", "id": "text", "label": "Tekst" },
        { "type": "image_picker", "id": "image", "label": "Billede fra appen" }
      ]
    },
    {
      "type": "feature",
      "name": "Funktion",
      "settings": [
        { "type": "text", "id": "title", "label": "Navn" },
        { "type": "text", "id": "text", "label": "Kort tekst" }
      ]
    }
  ],
  "presets": [
    { "name": "Lalatoto app-side" }
  ]
}
{% endschema %}
