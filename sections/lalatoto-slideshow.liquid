{%- comment -%}
  Lalatoto: slideshow øverst på forsiden. Billede i fuld bredde med tekst
  ovenpå i Lalatotos stil: lille etiket i versaler, overskrift i Playfair,
  kort tekst og en knap med tynd ramme.

  Teksten står nede i venstre hjørne på computer og i bunden på telefon. En
  blød mørk tone ligger kun under teksten, så resten af billedet står rent.
  Slides toner over i hinanden; tynde streger viser, hvor man er, og kan
  klikkes. På telefon kan man også swipe. Skriptet ligger i
  assets/lalatoto-slideshow.js.
{%- endcomment -%}

{%- liquid
  assign slide_count = section.blocks.size
  assign speed = section.settings.speed | default: 6

  comment
    «Følg billedet»: på computer får slideshowet samme format som det
    første liggende billede (mindst 16:10), så det vises helt. Stående
    billeder kan ikke vises helt i et bredt banner og beskæres derfor.
  endcomment
  assign ratio = 2.667
  for block in section.blocks
    if block.settings.image.aspect_ratio >= 1.6
      assign ratio = block.settings.image.aspect_ratio
      break
    endif
  endfor
-%}

{%- if slide_count > 0 -%}
  <lalatoto-slideshow
    class="lalatoto-slideshow lalatoto-slideshow--{{ section.settings.height }}"
    {% if section.settings.autoplay and slide_count > 1 %}data-autoplay="{{ speed }}"{% endif %}
    role="region"
    aria-roledescription="{{ 'lalatoto.slideshow.carousel' | t | escape }}"
    aria-label="{{ section.settings.label | default: 'Lalatoto' | escape }}"
    style="--lalatoto-slideshow-speed: {{ speed }}s; --lalatoto-slideshow-ratio: {{ ratio }};"
  >
    {%- for block in section.blocks -%}
      {%- liquid
        assign image_alt = block.settings.image.alt | default: block.settings.heading | strip_newlines
        assign overlay = block.settings.overlay | divided_by: 100.0
      -%}
      <div
        class="lalatoto-slideshow__slide lalatoto-slideshow__slide--{{ block.settings.text_position }}{% if forloop.first %} is-active{% endif %}"
        role="group"
        aria-roledescription="{{ 'lalatoto.slideshow.slide' | t | escape }}"
        aria-label="{{ forloop.index }} / {{ slide_count }}"
        {% unless forloop.first %}aria-hidden="true" inert{% endunless %}
        style="--lalatoto-slideshow-overlay: {{ overlay }};"
        {{ block.shopify_attributes }}
      >
        <div class="lalatoto-slideshow__media">
          {%- if block.settings.image != blank -%}
            <picture>
              {%- if block.settings.mobile_image != blank -%}
                <source
                  media="(max-width: 699px)"
                  srcset="{{ block.settings.mobile_image | image_url: width: 600 }} 600w, {{ block.settings.mobile_image | image_url: width: 900 }} 900w, {{ block.settings.mobile_image | image_url: width: 1200 }} 1200w, {{ block.settings.mobile_image | image_url: width: 1600 }} 1600w"
                  sizes="100vw"
                  width="{{ block.settings.mobile_image.width }}"
                  height="{{ block.settings.mobile_image.height }}"
                >
              {%- endif -%}
              {%- liquid
                if forloop.first
                  assign loading = 'eager'
                  assign priority = 'high'
                else
                  assign loading = 'lazy'
                  assign priority = 'auto'
                endif
              -%}
              {{-
                block.settings.image
                | image_url: width: 2800
                | image_tag:
                  loading: loading,
                  fetchpriority: priority,
                  sizes: '100vw',
                  widths: '800,1200,1600,2000,2400,2800',
                  alt: image_alt
              -}}
            </picture>
          {%- else -%}
            {{- 'lifestyle-1' | placeholder_svg_tag: 'lalatoto-slideshow__placeholder' -}}
          {%- endif -%}
        </div>

        <div class="lalatoto-slideshow__content">
          {%- if block.settings.kicker != blank -%}
            <p class="lalatoto-slideshow__kicker">{{ block.settings.kicker | escape }}</p>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            {%- if forloop.first -%}
              <h1 class="lalatoto-slideshow__heading">{{ block.settings.heading | escape | newline_to_br }}</h1>
            {%- else -%}
              <h2 class="lalatoto-slideshow__heading">{{ block.settings.heading | escape | newline_to_br }}</h2>
            {%- endif -%}
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="lalatoto-slideshow__text">{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
            <a href="{{ block.settings.button_link }}" class="lalatoto-slideshow__button">{{ block.settings.button_label | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}

    {%- if slide_count > 1 -%}
      <div class="lalatoto-slideshow__dots">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="lalatoto-slideshow__dot{% if forloop.first %} is-active{% endif %}"
            data-index="{{ forloop.index0 }}"
            aria-label="{{ 'lalatoto.slideshow.go_to' | t: number: forloop.index | escape }}"
            {% if forloop.first %}aria-current="true"{% endif %}
          >
            <span aria-hidden="true"></span>
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </lalatoto-slideshow>

  <script src="{{ 'lalatoto-slideshow.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Lalatoto slideshow",
  "class": "shopify-section--lalatoto-slideshow",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "Højde",
      "options": [
        { "value": "image", "label": "Følg billedet på computer" },
        { "value": "medium", "label": "Mellem" },
        { "value": "large", "label": "Stor" },
        { "value": "full", "label": "Hele skærmen" }
      ],
      "default": "image",
      "info": "«Følg billedet»: hele billedet vises på computer. Brug liggende billeder i samme format, fx 3200 × 1200 px."
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Skift selv mellem slides",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Sekunder pr. slide",
      "min": 4,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "text",
      "id": "label",
      "label": "Navn til skærmlæsere",
      "default": "Udvalgt på forsiden"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Billede",
          "info": "Liggende, fx 3200 × 1200 px. Alle slides bør have samme format."
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Billede på telefon",
          "info": "Stående, fx 1200 × 1600 px. Tomt: samme billede som på computer."
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Lille etiket over overskriften"
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Overskrift",
          "info": "Linjeskift med Enter.",
          "default": "Ingen polyester.\nIngen kompromiser."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Tekst"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Knaptekst"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Knappens link"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Tekstens placering på computer",
          "options": [
            { "value": "left", "label": "Nede til venstre" },
            { "value": "center", "label": "Midt for" }
          ],
          "default": "left"
        },
        {
          "type": "range",
          "id": "overlay",
          "label": "Mørk tone under teksten",
          "min": 0,
          "max": 70,
          "step": 5,
          "unit": "%",
          "default": 40
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lalatoto slideshow",
      "blocks": [{ "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
