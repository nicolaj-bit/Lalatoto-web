<style>
  .top_collection_list_main {
    width: 100%;
    height: auto;
    padding: 20px 0;
    background-color: {{ section.settings.background_color }};
    overflow: hidden;
    position: relative;
  }

  .top_collection_list_in {
    display: flex;
    justify-content: center; /* Center indholdet */
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 20px;
    scroll-behavior: smooth;
    padding: 0 40px;
  }

  .top_collection_list_in::-webkit-scrollbar {
    display: none;
  }

  .top_collection_list_block {
flex: 0 0 auto;
width: 100px;
scroll-snap-align: center;
padding: 10px;
box-sizing: border-box;
display: flex;
flex-direction: column;
align-items: center;
position: relative;
}

  .top_collection_img {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background-color: #f4f4f4;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 10px;
    overflow: hidden;
  }

  .top_collection_img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .top_collection_txt {
    text-align: center;
    color: {{ section.settings.text_color }};
    font-size: 13px;
    margin-top: 15px;
    text-transform: uppercase;
  }

  .top_collection_badge {
    position: absolute;
    top: 0;
    right: 5%;
    background-color: {{ section.settings.badge_color }};
    color: #fff;
    padding: 0 10px;
    font-size: 11px;
    border-radius: 5px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 40px;
    height: 40px;
    background-color: #fff;
    border: 1px solid #ccc;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
  }

  .arrow::before {
    content: '';
    display: block;
    width: 10px;
    height: 10px;
    border-top: 2px solid #333;
    border-right: 2px solid #333;
  }

  .arrow-left { left: 10px; }
  .arrow-left::before { transform: rotate(-135deg); }

  .arrow-right { right: 10px; }
  .arrow-right::before { transform: rotate(45deg); }

  @media screen and (max-width: 768px) {
    .arrow { display: none; }
  }

  @media screen and (min-width: 769px) {
  .arrow {
    display: none !important;
  }
}

</style>


<div class="top_collection_list_main">
  <h3 style="text-align:center;">{{ section.settings.heading }}</h3>
  <div class="arrow arrow-left" onclick="scrollCollection(-1)"></div>
  <div class="top_collection_list_in" id="collectionSlider">
    {% for block in section.blocks %}
      <a href="{{ block.settings.url }}" class="top_collection_list_block">
        <div class="top_collection_img">
          <img src="{{ block.settings.image | img_url: '100x' }}" alt="" width="100" height="100">
        </div>
        <p class="top_collection_txt">{{ block.settings.heading }}</p>
        {% if block.settings.badge != blank %}
          <div class="top_collection_badge">
            <span>{{ block.settings.badge }}</span>
          </div>
        {% endif %}
      </a>
    {% endfor %}
  </div>
  <div class="arrow arrow-right" onclick="scrollCollection(1)"></div>
</div>

<script>
  function scrollCollection(direction) {
    const container = document.getElementById('collectionSlider');
    const scrollAmount = container.offsetWidth / 2;
    container.scrollBy({
      left: direction * scrollAmount,
      behavior: 'smooth'
    });
  }
</script>


{% schema %}
{
  "name": "Top collection list",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Baggrundsfarve",
      "default": "#efefef"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Tekstfarve",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge farve",
      "default": "#8E5F40"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Populære kollektioner"
    },
    {
      "type": "range",
      "id": "columns_per_row",
      "label": "Kolonner per række",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection List",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Collection image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Overskrift",
          "default": "Kollektion"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Top collection list",
      "category": "Tilpasset"
    }
  ]
}
{% endschema %}