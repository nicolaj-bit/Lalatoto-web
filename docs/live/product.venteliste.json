        "lalatoto_venteliste": {
          "type": "liquid",
          "settings": {
            "liquid": "{%- comment -%}\n  Lalatoto: venteliste til LALA Hvalen (skabelonen product.venteliste).\n  Vises i stedet for Læg i kurv, når den valgte størrelse ikke er på lager.\n  Tilmeldinger oprettes som kunder med mærkerne venteliste,\n  venteliste-<produkt> og venteliste-<produkt>-<variant>. Flueben ved\n  nyhedsbrevet tilføjer mærket nyhedsbrev-samtykke.\n{%- endcomment -%}\n{%- assign lw_variant = product.selected_or_first_available_variant -%}\n<style>\n  /* Størrelsesknapper: temaets udseende, men uden kant om boksene */\n  .product-info .block-swatch, .product-info :checked + .block-swatch, .product-info .block-swatch.is-selected { border-color: transparent; }\n  .product-info .block-swatch.is-disabled::before { content: none; }\n  .product-info:has(.lalatoto-waitlist) .product-info__block-item[data-block-type='buy-buttons'],\n  body:has(.lalatoto-waitlist) .product-sticky-bar { display: none !important; }\n  .lalatoto-waitlist { padding-block: 1.75rem 1.5rem; border-block: 1px solid rgb(var(--text-color) / .15); color: rgb(var(--text-color)); }\n  .lalatoto-waitlist form { display: grid; gap: 1.25rem; margin: 0; }\n  .lalatoto-waitlist__status { display: flex; align-items: center; gap: .625rem; font-size: .6875rem; letter-spacing: .18em; text-transform: uppercase; color: rgb(var(--text-color) / .65); }\n  .lalatoto-waitlist__dot { position: relative; width: .4375rem; height: .4375rem; border-radius: 50%; background: rgb(var(--text-color)); }\n  .lalatoto-waitlist__dot::after { content: ''; position: absolute; inset: -.25rem; border: 1px solid rgb(var(--text-color)); border-radius: 50%; opacity: 0; animation: lalatoto-pulse 2.4s ease-out infinite; }\n  .lalatoto-waitlist__title { margin: 0; max-width: 16em; font-family: var(--heading-font-family); font-weight: var(--heading-font-weight); font-size: clamp(1.375rem, 1.2rem + .7vw, 1.75rem); line-height: 1.2; letter-spacing: normal; text-transform: none; text-wrap: balance; }\n  .lalatoto-waitlist__title em, .lalatoto-waitlist__text em { font-style: italic; }\n  .lalatoto-waitlist__text { margin: -.5rem 0 0; max-width: 36ch; color: rgb(var(--text-color) / .65); line-height: 1.6; }\n  .lalatoto-waitlist__field { position: relative; margin-block-start: .5rem; }\n  .lalatoto-waitlist__field input { display: block; width: 100%; padding: 1.375rem 0 .625rem; border: 0; border-block-end: 1px solid rgb(var(--text-color) / .25); border-radius: 0; background: transparent; color: rgb(var(--text-color)); font-size: 1rem; box-shadow: none; outline: none; appearance: none; transition: border-color .2s; }\n  .lalatoto-waitlist__field input:focus { border-block-end-color: rgb(var(--text-color)); }\n  .lalatoto-waitlist__field label { position: absolute; left: 0; top: 1.375rem; color: rgb(var(--text-color) / .65); font-size: 1rem; pointer-events: none; transform-origin: left top; transition: transform .2s; }\n  .lalatoto-waitlist__field input:focus + label, .lalatoto-waitlist__field input:not(:placeholder-shown) + label { transform: translateY(-1.125rem) scale(.72); letter-spacing: .14em; text-transform: uppercase; }\n  .lalatoto-waitlist__error { margin: -.75rem 0 0; color: rgb(var(--error-text, 203 43 43)); font-size: .8125rem; }\n  .lalatoto-waitlist .button { width: 100%; display: flex; justify-content: space-between; align-items: center; }\n  .lalatoto-waitlist__arrow { transition: transform .25s; }\n  .lalatoto-waitlist .button:hover .lalatoto-waitlist__arrow { transform: translateX(5px); }\n  .lalatoto-waitlist__consent { display: inline-flex; align-items: center; gap: .625rem; justify-self: start; font-size: .875rem; cursor: pointer; }\n  .lalatoto-waitlist__consent input { position: absolute; opacity: 0; width: 1px; height: 1px; }\n  .lalatoto-waitlist__box { position: relative; flex-shrink: 0; width: .875rem; height: .875rem; border: 1px solid rgb(var(--text-color)); }\n  .lalatoto-waitlist__consent input:checked + .lalatoto-waitlist__box { background: rgb(var(--text-color)); }\n  .lalatoto-waitlist__consent input:checked + .lalatoto-waitlist__box::after { content: ''; position: absolute; left: 4px; top: 1px; width: 4px; height: 7px; border: solid rgb(var(--background)); border-width: 0 1px 1px 0; transform: rotate(45deg); }\n  .lalatoto-waitlist__consent input:focus-visible + .lalatoto-waitlist__box { outline: 1px solid rgb(var(--text-color)); outline-offset: 3px; }\n  .lalatoto-waitlist__fine { margin: -.5rem 0 0; max-width: 44ch; color: rgb(var(--text-color) / .65); font-size: .75rem; line-height: 1.55; }\n  .lalatoto-waitlist__done { display: grid; justify-items: start; gap: 1rem; }\n  .lalatoto-waitlist__check { width: 3rem; height: 3rem; fill: none; stroke: rgb(var(--text-color)); stroke-width: 1; stroke-linecap: round; stroke-linejoin: round; }\n  .lalatoto-waitlist__check circle { stroke: rgb(var(--text-color) / .25); stroke-dasharray: 145; stroke-dashoffset: 145; animation: lalatoto-draw .7s ease-out forwards; }\n  .lalatoto-waitlist__check path { stroke-dasharray: 30; stroke-dashoffset: 30; animation: lalatoto-draw .4s ease-out .55s forwards; }\n  @keyframes lalatoto-draw { to { stroke-dashoffset: 0; } }\n  @keyframes lalatoto-pulse { 0% { opacity: .6; transform: scale(.6); } 70%, 100% { opacity: 0; transform: scale(1.6); } }\n  @media (prefers-reduced-motion: reduce) { .lalatoto-waitlist__dot::after { animation: none; } .lalatoto-waitlist__check circle, .lalatoto-waitlist__check path { animation: none; stroke-dashoffset: 0; } }\n</style>\n{%- if lw_variant != blank and lw_variant.available == false -%}\n  {%- liquid\n    assign lw_tag_product = 'venteliste-' | append: product.handle\n    assign lw_tag_variant = lw_tag_product | append: '-' | append: lw_variant.title | handleize\n    assign lw_tags = 'venteliste,' | append: lw_tag_product | append: ',' | append: lw_tag_variant\n  -%}\n  <div class=\"lalatoto-waitlist\">\n    {%- form 'customer', id: 'lalatoto-waitlist-live' -%}\n      {%- if form.posted_successfully? -%}\n        <div class=\"lalatoto-waitlist__done\" role=\"status\">\n          <svg class=\"lalatoto-waitlist__check\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"24\" cy=\"24\" r=\"23\" /><path d=\"M15 24.5l6 6 12-13\" /></svg>\n          <p class=\"lalatoto-waitlist__title\">Tak. <em>Du er på listen.</em></p>\n          <p class=\"lalatoto-waitlist__text\">Vi sender én besked, når <em>{{ product.title | escape }}</em> kan købes.</p>\n        </div>\n      {%- else -%}\n        <div class=\"lalatoto-waitlist__status\"><span class=\"lalatoto-waitlist__dot\" aria-hidden=\"true\"></span><span>Venteliste</span></div>\n        <p class=\"lalatoto-waitlist__title\">Vær den første, når <em>{{ product.title | escape }}</em> er her</p>\n        <p class=\"lalatoto-waitlist__text\">Skriv din e-mail, så sender vi én besked, så snart den kan købes.</p>\n        <input type=\"hidden\" name=\"contact[tags]\" value=\"{{ lw_tags | escape }}\" data-base-tags=\"{{ lw_tags | escape }}\">\n        <div class=\"lalatoto-waitlist__field\">\n          <input type=\"email\" id=\"lalatoto-waitlist-live-email\" name=\"contact[email]\" required autocomplete=\"email\" inputmode=\"email\" spellcheck=\"false\" placeholder=\" \" {% if form.errors %}aria-invalid=\"true\" aria-describedby=\"lalatoto-waitlist-live-error\"{% endif %}>\n          <label for=\"lalatoto-waitlist-live-email\">Din e-mail</label>\n        </div>\n        {%- if form.errors -%}\n          <p class=\"lalatoto-waitlist__error\" id=\"lalatoto-waitlist-live-error\">Tjek, at e-mailadressen er skrevet rigtigt.</p>\n        {%- endif -%}\n        <button type=\"submit\" class=\"button\"><span>Skriv mig op</span><span class=\"lalatoto-waitlist__arrow\" aria-hidden=\"true\">→</span></button>\n        <label class=\"lalatoto-waitlist__consent\"><input type=\"checkbox\" data-lalatoto-newsletter><span class=\"lalatoto-waitlist__box\" aria-hidden=\"true\"></span><span>Send mig også nyhedsbrevet</span></label>\n        <p class=\"lalatoto-waitlist__fine\">Vi skriver kun om denne vare, medmindre du også vælger nyhedsbrevet. Du kan altid framelde dig.</p>\n      {%- endif -%}\n    {%- endform -%}\n  </div>\n{%- endif -%}\n<script>\n  if (!window.lalatotoWaitlistReady) {\n    window.lalatotoWaitlistReady = true;\n    document.addEventListener('change', function (event) {\n      var box = event.target.closest && event.target.closest('[data-lalatoto-newsletter]');\n      if (!box) return;\n      var tags = box.form && box.form.querySelector('input[name=\"contact[tags]\"]');\n      if (!tags) return;\n      var base = tags.getAttribute('data-base-tags');\n      tags.value = box.checked ? base + ',nyhedsbrev-samtykke' : base;\n    });\n  }\n</script>"
          }
        },
